#!/usr/bin/python3
# omarchy:summary=Show this user's process groups by memory use (RAM + swap)
# omarchy:args=[--json] [--pick <min-mb>]
# omarchy:examples=omarchy memory top | omarchy memory top --pick 1024

# A group is (cgroup, process group id). Neither alone works: apps launched from
# Hyprland all share Hyprland's pgid, while one terminal scope holds the
# terminal, its shells, and every build they started, each in its own pgid.
# Signals therefore go to a group's pids, never to `kill -- -pgid`.
#
# --pick prints "key<TAB>total_mb<TAB>name<TAB>pids" for the largest group that
# is unprotected, not already stopped, and at least <min-mb>; exit 1 if none.
#
# OMARCHY_MEMORY_PROTECT  regex on process names that protects a whole group
# OMARCHY_MEMORY_ONLY     if set, --pick only considers groups whose leader matches

import json
import os
import re
import sys

DEFAULT_PROTECT = (
    r"^(Hyprland|Xwayland|start-hyprland|systemd.*|\(sd-pam\)|pipewire.*|wireplumber|"
    r"sddm.*|dbus-.*|uwsm.*|omarchy-memory.*|quickshell|walker|elephant|swayosd.*|"
    r"hyprpaper|hypridle|hyprlock|xdg-.*|gnome-keyring.*|fcitx5|"
    r"alacritty|ghostty|kitty|foot|steam.*|gamescope.*|wine.*|.*\.exe)$"
)
PROTECT = re.compile(os.environ.get("OMARCHY_MEMORY_PROTECT") or DEFAULT_PROTECT)
# Games under Proton or Wine show up as generic loader names; the cmdline gives them away.
PROTECT_CMD = re.compile(r"steamapps|/proton|\.exe\b", re.I)
ONLY = os.environ.get("OMARCHY_MEMORY_ONLY")


def read(path, mode="r"):
    with open(path, mode) as f:
        return f.read()


def scan():
    uid = os.getuid()
    groups = {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            status = read(f"/proc/{pid}/status")
            stat = read(f"/proc/{pid}/stat")
            cmd = read(f"/proc/{pid}/cmdline", "rb").replace(b"\0", b" ")
            cmd = cmd.decode(errors="replace").strip()
            cgroup = read(f"/proc/{pid}/cgroup").strip().split("::")[-1]
        except OSError:
            continue
        fields = dict(l.split(":", 1) for l in status.splitlines() if ":" in l)
        if int(fields["Uid"].split()[0]) != uid:
            continue
        kb = lambda k: int(fields.get(k, "0 kB").split()[0])
        rest = stat[stat.rindex(")") + 2:].split()
        state, ppid, pgid = rest[0], int(rest[1]), int(rest[2])
        name = fields["Name"].strip()
        key = f"{cgroup}#{pgid}"
        g = groups.setdefault(key, {
            "key": key, "cgroup": cgroup, "unit": cgroup.rsplit("/", 1)[-1],
            "pgid": pgid, "rss_mb": 0, "swap_mb": 0, "pids": [], "ppids": {},
            "stopped": 0, "protected": False, "leader": None, "leader_cmd": "",
        })
        g["rss_mb"] += kb("VmRSS") // 1024
        g["swap_mb"] += kb("VmSwap") // 1024
        g["pids"].append(int(pid))
        g["ppids"][int(pid)] = ppid
        g["stopped"] += state == "T"
        if PROTECT.match(name) or PROTECT_CMD.search(cmd) or "omarchy-memory" in cgroup:
            g["protected"] = True
        if int(pid) == pgid or g["leader"] is None:
            g["leader"], g["leader_cmd"] = name, cmd[:160]
    out = list(groups.values())
    for g in out:
        g["total_mb"] = g["rss_mb"] + g["swap_mb"]
        g["pids"].sort()
    out.sort(key=lambda g: -g["total_mb"])
    return out


def pick(groups, min_mb):
    for g in groups:
        if g["total_mb"] < min_mb:
            return None
        if g["protected"] or g["stopped"] == len(g["pids"]):
            continue
        if ONLY and not re.search(ONLY, g["leader"] + " " + g["leader_cmd"]):
            continue
        return g
    return None


def main():
    groups = scan()
    if "--json" in sys.argv:
        for g in groups:
            del g["ppids"]
        json.dump(groups, sys.stdout, indent=1)
        return 0
    if "--pick" in sys.argv:
        g = pick(groups, int(sys.argv[sys.argv.index("--pick") + 1]))
        if g is None:
            return 1
        print(g["key"], g["total_mb"], g["leader"], ",".join(map(str, g["pids"])), sep="\t")
        return 0
    print(f"{'TOTAL':>7} {'RSS':>7} {'SWAP':>7} {'N':>4} P S  LEADER  [UNIT PGID]  CMD")
    for g in groups[:int(os.environ.get("OMARCHY_MEMORY_TOP_N", 20))]:
        print(f"{g['total_mb']:>6}M {g['rss_mb']:>6}M {g['swap_mb']:>6}M "
              f"{len(g['pids']):>4} {'P' if g['protected'] else '-'} "
              f"{'T' if g['stopped'] else '-'}  {g['leader']}  [{g['unit']} pgid={g['pgid']}]"
              f"  {g['leader_cmd'][:80]}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
