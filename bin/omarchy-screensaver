#!/bin/bash

# omarchy:summary=Run the Omarchy screensaver using random effects from TTE.

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
  pkill -x ttfx 2>/dev/null
  pkill -x ttfx-audio 2>/dev/null
  pkill -f '[o]rg.omarchy.screensaver' 2>/dev/null
  exit 0
}

# Exit the screensaver on signals and input from keyboard and mouse
trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'  # Set background color to black

hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null

tty=$(tty 2>/dev/null)

# Terminals allocate the pty at the default 80x24 and only resize it once the
# compositor has told the window how big it is. ttfx measures the terminal once,
# at startup, so starting it before the resize lands sizes an 80x24 canvas and
# paints it into the corner of a fullscreen window.
wait_for_terminal_resize() {
  local deadline=$((SECONDS + 2))
  while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
    sleep 0.02
  done
}

wait_for_terminal_resize

# React to whatever is playing when ttfx was built with audio support:
# ttfx-audio listens to the default sink (one instance serves every monitor)
# and --audio makes the effects follow the music.
audio_args=()
if command -v ttfx-audio >/dev/null && ttfx --help 2>&1 | grep -q -- '--audio'; then
  ttfx-audio &>/dev/null &
  audio_args=(--audio --audio-pulse "${OMARCHY_SCREENSAVER_PULSE:-2a1f4a}")
fi

# A second text that bursts out from behind the branding partway through
# each effect and carries on the animation, when ttfx supports it.
takeover_text=~/.config/omarchy/branding/screensaver-takeover.txt
takeover_args=()
if [[ -s $takeover_text ]] && ttfx --help 2>&1 | grep -q -- '--takeover'; then
  takeover_args=(--takeover "$takeover_text")
fi

# Now and then the takeover text spins as a 3D solid instead.
spin_chance=0
if [[ -n ${takeover_args[*]} ]] && ttfx --help 2>&1 | grep -q '^  spin3d '; then
  spin_chance=${OMARCHY_SCREENSAVER_SPIN_CHANCE:-4}
fi

# Now and then lightning erodes OMARCHY revealing KEWK.
erode_chance=0
if ttfx --help 2>&1 | grep -q -- '--erode'; then
  erode_chance=${OMARCHY_SCREENSAVER_ERODE_CHANCE:-6}
fi

while true; do
  if ((spin_chance > 0 && RANDOM % spin_chance == 0)); then
    ttfx -i "$takeover_text" \
      --frame-rate 60 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c\
      --no-eol --no-restore-cursor spin3d --duration 80 &
  elif ((erode_chance > 0 && RANDOM % erode_chance == 0)); then
    ttfx -i ~/.config/omarchy/branding/screensaver.txt \
      --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c\
      --no-eol --no-restore-cursor "${audio_args[@]}" "${takeover_args[@]}" \
      thunderstorm --storm-time 30 --erode &
  else
    ttfx -i ~/.config/omarchy/branding/screensaver.txt \
      --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c\
      --random-effect --no-eol --no-restore-cursor "${audio_args[@]}" "${takeover_args[@]}" &
  fi

  while pgrep -t "${tty#/dev/}" -x ttfx >/dev/null; do
    if read -n1 -t 1 || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done
done
