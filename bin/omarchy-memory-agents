#!/usr/bin/python3
# omarchy:summary=Show which AI agents are using the memory, charged per agent
# omarchy:args=[--json]
# omarchy:examples=omarchy memory agents | omarchy memory agents --json

# Every process is charged to the nearest AI agent above it in the process tree,
# so a build or headless editor an agent started counts against that agent.
#
# Each agent carries a messaging route for the memory responder:
#   claude-peer  a Claude Code session; reachable with its SendMessage tool by "name"
#   none         no channel; read its transcript or cmdline to learn what it's doing

import glob
import importlib.machinery
import importlib.util
import json
import os
import shutil
import sys
import time

CLAUDE_HOME = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
# Claude Code's session and subagent files are not a published interface, so
# everything read from them is optional. A subagent counts as active while its
# transcript is still being written.
SUBAGENT_ACTIVE = 600

loader = importlib.machinery.SourceFileLoader("top", shutil.which("omarchy-memory-top"))
top = importlib.util.module_from_spec(importlib.util.spec_from_loader("top", loader))
loader.exec_module(top)


def agent_kind(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return top.agent_kind(f.read().split(b"\0"))
    except OSError:
        return None


def parent(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            stat = f.read()
    except OSError:
        return None
    return int(stat[stat.rindex(")") + 2:].split()[1])


def claude_session(pid):
    try:
        with open(os.path.join(CLAUDE_HOME, "sessions", f"{pid}.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def transcript(session_id):
    hits = glob.glob(os.path.join(CLAUDE_HOME, "projects", "*", f"{session_id}.jsonl"))
    return hits[0] if hits else None


def subagents(session_id):
    out = []
    pattern = os.path.join(CLAUDE_HOME, "projects", "*", session_id or "-", "subagents", "agent-*.jsonl")
    for path in glob.glob(pattern):
        try:
            if time.time() - os.path.getmtime(path) > SUBAGENT_ACTIVE:
                continue
            with open(path[: -len(".jsonl")] + ".meta.json") as f:
                meta = json.load(f)
        except (OSError, ValueError):
            meta = {}
        out.append({"description": meta.get("description") or "", "transcript": path})
    return out


def main():
    agents, kinds = {}, {}

    def owner(pid):
        # Starts above the pid: an agent is charged for what it spawned, not itself.
        seen = 0
        while pid and pid > 1 and seen < 64:
            pid, seen = parent(pid), seen + 1
            if pid is None:
                return None
            if pid not in kinds:
                kinds[pid] = agent_kind(pid)
            if kinds[pid]:
                return pid
        return None

    for g in top.scan():
        # Not the responder, and not this scan itself.
        if g["total_mb"] < 16 or "omarchy-memory" in g["cgroup"] or os.getpid() in g["pids"]:
            continue
        leader = g["pgid"] if g["pgid"] in g["pids"] else g["pids"][0]
        own = owner(leader)
        if own is None:
            continue
        if own not in agents:
            s = claude_session(own) if kinds[own] == "claude" else {}
            path = transcript(s["sessionId"]) if s.get("sessionId") else None
            try:
                cwd = os.readlink(f"/proc/{own}/cwd")
            except OSError:
                cwd = None
            agents[own] = {
                "id": f"{kinds[own]}-{own}", "kind": kinds[own], "pid": own, "cwd": cwd,
                "name": s.get("name"), "status": s.get("status"),
                "route": "claude-peer" if s.get("name") else "none",
                "transcript": path, "subagents": subagents(s.get("sessionId")),
                "total_mb": 0, "groups": [],
            }
        a = agents[own]
        a["total_mb"] += g["total_mb"]
        a["groups"].append({"total_mb": g["total_mb"], "leader": g["leader"], "pids": g["pids"],
                            "stopped": g["stopped"], "cmd": g["leader_cmd"]})

    out = sorted(agents.values(), key=lambda a: -a["total_mb"])
    for a in out:
        a["groups"] = sorted(a["groups"], key=lambda g: -g["total_mb"])[:10]

    if "--json" in sys.argv:
        json.dump(out, sys.stdout, indent=1)
        return
    for a in out:
        print(f"{a['total_mb']:>7}M  {a['id']:<18} {a['name'] or '-':<18} "
              f"route={a['route']:<11} {a['status'] or ''}  cwd={a['cwd']}")
        for s in a["subagents"]:
            print(f"{'':>10}subagent: {s['description']}")
        for g in a["groups"][:5]:
            print(f"{'':>10}{g['total_mb']:>6}M {g['leader']} {'(stopped) ' if g['stopped'] else ''}"
                  f"pids={','.join(map(str, g['pids'][:6]))}  {g['cmd'][:70]}")


if __name__ == "__main__":
    main()
