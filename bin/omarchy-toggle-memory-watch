#!/bin/bash

# omarchy:summary=Toggle the memory watchdog that warns before systemd-oomd kills an app
# omarchy:args=[toggle|on|off]
# omarchy:examples=omarchy toggle memory-watch | omarchy toggle memory-watch off

# Off by default: it is one more daemon sampling every two seconds, and every
# toast it sends is critical, so that is the user's call to make.

# nf-md-memory, escaped so this file reads without a Nerd Font.
readonly MEMORY_GLYPH=$'\U000f035b'

unit_name=omarchy-memory-watch.service
unit="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$unit_name"
unit_source="$OMARCHY_PATH/default/systemd/user/$unit_name"

omarchy-toggle memory-watch-on "${1:-toggle}" || exit 1

# The toggle installs the unit into ~/.config/systemd/user, copied each time
# it is turned on, so a changed unit is only picked up by turning it off and
# on again. The unit also checks the flag with ConditionPathExists, so a copy
# enabled without the flag, or one a package put in /usr/lib/systemd/user,
# stays inert.
if omarchy-toggle-enabled memory-watch-on; then
  # A unit whose condition fails starts nothing and still reports success, so
  # it only counts as on once it is running.
  if install -Dm644 "$unit_source" "$unit" && systemctl --user daemon-reload &&
    systemctl --user enable --now "$unit_name" && systemctl --user is-active --quiet "$unit_name"; then
    omarchy-notification-send -g "$MEMORY_GLYPH" "$(omarchy-i18n memory.watchdogEnabled)"
  else
    # A flag left on would say memory is watched while nothing watches it.
    omarchy-toggle memory-watch-on off
    systemctl --user disable --now "$unit_name"
    rm -f "$unit"
    systemctl --user daemon-reload
    omarchy-notification-send -u critical -g "$MEMORY_GLYPH" "$(omarchy-i18n memory.watchdogFailed)" \
      "$(omarchy-i18n memory.seeCommand "journalctl --user -u $unit_name")"
    exit 1
  fi
else
  systemctl --user disable --now "$unit_name"
  rm -f "$unit"
  systemctl --user daemon-reload
  omarchy-notification-send -g "$MEMORY_GLYPH" "$(omarchy-i18n memory.watchdogDisabled)"
fi
