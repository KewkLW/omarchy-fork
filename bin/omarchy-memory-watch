#!/bin/bash

# omarchy:summary=Watch memory pressure; warn before systemd-oomd kills an app, and pause the runaway first
# omarchy:hidden=true

# systemd-oomd only kills scopes under app.slice
# (default/systemd/user/app.slice.d/10-oomd.conf), and always a whole scope:
# a terminal takes every shell and build in it along. It acts on one of two
# lines: RAM and swap both more than 90% used (SwapUsedLimit), or app.slice
# stalled on memory for half the time, held for 20s
# (etc/systemd/oomd.conf.d/10-omarchy.conf). It cannot kill the compositor or
# anything else in session.slice, which it does not look at, so a runaway
# there, such as one Hyprland started itself, carries on while oomd takes
# innocent apps. Neither line is visible from the desktop, so the first sign
# is a window gone. This samples the same numbers oomd reads:
#
#   warn   swap 50% used with RAM 80% used, or RAM 90% used with a 20% stall,
#          about halfway to oomd's lines: a critical toast naming the largest
#          process group, while there is still time to close it. Never swap
#          alone: zram is sized to RAM, so half of it in use is routine while
#          RAM is fine.
#   brake  swap 75% used with RAM 85% used, short of oomd's 90% and 90%, or
#          RAM 97% used with a 40% stall, short of its 50% held for 20s:
#          SIGSTOP the largest process group with nothing protected in it, or
#          the largest unprotected process tree inside one that has
#          (omarchy-memory-top --pick), wherever it runs. Paused, not killed;
#          omarchy-memory-resume undoes it. Swap alone never brakes: zram is
#          sized to RAM, so half of it in use is routine while RAM is fine,
#          and a pause frees no swap. One pause at a time: while something the
#          brake paused is still stopped, it does not pause anything else.
#   kills  after oomd kills, a toast naming what it took (omarchy-memory-oomd-kills).
#
# Thresholds are environment variables; change them with a drop-in from
# `systemctl --user edit omarchy-memory-watch`.

set -uo pipefail

readonly STATE=$HOME/.local/state/omarchy/memory-watch
readonly LOG=$STATE/watch.log
# What memory looked like when it was last tight, so a kill can be named after
# the process is gone.
readonly LAST_TOP=$STATE/last-top.json
# What is paused, one line per pause (see omarchy-memory-resume):
#   time source key total_mb name pids starts
# source is brake, responder or user. Written under FROZEN_LOCK.
readonly FROZEN=$STATE/frozen.tsv
readonly FROZEN_LOCK=$STATE/frozen.lock
# nf-md-memory, escaped so this file reads without a Nerd Font.
readonly MEMORY_GLYPH=$'\U000f035b'

# Overridable so the tests can feed the watcher numbers.
meminfo=${OMARCHY_MEMORY_MEMINFO:-/proc/meminfo}
pressure=${OMARCHY_MEMORY_PRESSURE:-/proc/pressure/memory}
proc=${OMARCHY_MEMORY_PROC:-/proc} # where the paused processes' state is read
# oomd's pressure line is app.slice's own stall, which can run ahead of the
# system's, so the higher of the two counts.
app_pressure=${OMARCHY_MEMORY_APP_PRESSURE:-/sys/fs/cgroup/user.slice/user-$UID.slice/user@$UID.service/app.slice/memory.pressure}

interval=${OMARCHY_MEMORY_INTERVAL:-2}
warn_swap_pct=${OMARCHY_MEMORY_WARN_SWAP_PCT:-50}         # with warn_swap_mem_pct; oomd: 90 and 90
warn_swap_mem_pct=${OMARCHY_MEMORY_WARN_SWAP_MEM_PCT:-80}
warn_mem_pct=${OMARCHY_MEMORY_WARN_MEM_PCT:-90}   # with warn_psi
warn_psi=${OMARCHY_MEMORY_WARN_PSI:-20}           # full avg10; oomd kills at 50 held for 20s
warn_gap=${OMARCHY_MEMORY_WARN_GAP:-300}
brake_swap_pct=${OMARCHY_MEMORY_BRAKE_SWAP_PCT:-75}         # with brake_swap_mem_pct; oomd: 90 and 90
brake_swap_mem_pct=${OMARCHY_MEMORY_BRAKE_SWAP_MEM_PCT:-85}
brake_mem_pct=${OMARCHY_MEMORY_BRAKE_MEM_PCT:-97} # with brake_psi: thrashing before swap fills
brake_psi=${OMARCHY_MEMORY_BRAKE_PSI:-40}
brake_min_mb=${OMARCHY_MEMORY_BRAKE_MIN_MB:-1024}
brake_gap=${OMARCHY_MEMORY_BRAKE_GAP:-10}

mkdir -p "$STATE"

log() {
  printf '%s %s\n' "$(date '+%F %T')" "$*" | tee -a "$LOG" >&2
}

full_avg10() {
  [[ -r $1 ]] && awk '/^full/ { split($2, a, "="); printf "%d", a[2] }' "$1"
}

read_metrics() {
  local key value _ app
  while read -r key value _; do
    case $key in
    MemTotal:) mem_total=$value ;;
    MemAvailable:) mem_avail=$value ;;
    SwapTotal:) swap_total=$value ;;
    SwapFree:) swap_free=$value ;;
    esac
  done <"$meminfo"
  mem_pct=$((100 - mem_avail * 100 / mem_total))
  swap_pct=0
  ((swap_total > 0)) && swap_pct=$(((swap_total - swap_free) * 100 / swap_total))
  psi=$(full_avg10 "$pressure")
  app=$(full_avg10 "$app_pressure")
  psi=${psi:-0}
  ((${app:-0} > psi)) && psi=$app
}

metrics() {
  echo "ram ${mem_pct}% ($((mem_avail / 1024))M free), swap ${swap_pct}%, pressure ${psi}"
}

snapshot() {
  omarchy-memory-top --json >"$LAST_TOP.tmp" 2>/dev/null && mv "$LAST_TOP.tmp" "$LAST_TOP"
}

warn() {
  local largest line
  largest=$(jq -r 'first(.[]) | "\(.leader), \(.total_mb)M"' "$LAST_TOP" 2>/dev/null)
  if ((swap_pct >= warn_swap_pct && mem_pct >= warn_swap_mem_pct)); then
    line="Swap ${swap_pct}% and RAM ${mem_pct}% used; systemd-oomd kills an app once both pass 90%."
  else
    line="RAM ${mem_pct}% used and apps stalling (${psi}%); systemd-oomd kills an app once the stall holds 50% for 20s."
  fi
  log "warn: $(metrics), largest ${largest:-unknown}"
  omarchy-notification-send --urgency critical --glyph "$MEMORY_GLYPH" \
    "Memory is running out" \
    "$line Largest: ${largest:-unknown}. See: omarchy memory top" >/dev/null 2>&1 &
}

start_time() {
  local stat
  { stat=$(<"$proc/$1/stat"); } 2>/dev/null || return 1
  stat=${stat##*) }
  read -ra stat <<<"$stat"
  echo "${stat[19]}"
}

# Whether a SIGSTOP sent to the process has yet to take effect: one sent to a
# process in uninterruptible sleep (disk I/O, say) waits until that is over,
# and the process stops later, so its record must stay until then.
stop_pending() {
  local status mask
  { status=$(<"$proc/$1/status"); } 2>/dev/null || return 1
  for mask in SigPnd ShdPnd; do
    [[ $status =~ $mask:[[:space:]]*([0-9a-f]+) ]] && ((16#${BASH_REMATCH[1]} & 0x40000)) && return 0
  done
  return 1
}

# Whether any of the pids is still stopped, or about to stop, with its
# recorded start time.
still_paused() {
  local pids starts i stat
  IFS=, read -ra pids <<<"$1"
  IFS=, read -ra starts <<<"$2"
  for i in "${!pids[@]}"; do
    { stat=$(<"$proc/${pids[i]}/stat"); } 2>/dev/null || continue
    stat=${stat##*) }
    read -ra stat <<<"$stat"
    [[ ${stat[19]} == "${starts[i]:-}" ]] || continue
    [[ ${stat[0]} == [Tt] ]] && return 0
    stop_pending "${pids[i]}" && return 0
  done
  return 1
}

# Drops pauses nothing is left of: exited, killed, or resumed some other way.
prune_frozen() {
  [[ -s $FROZEN ]] || return 0
  (
    flock -w 5 9 || exit 0
    kept=$(mktemp "$FROZEN.XXXXXX") || exit 0
    # Every line is checked in before the file is replaced: with the disk
    # full, a copy that lost lines would lose the pauses they record, and
    # the old file keeps them until the next prune can.
    while IFS=$'\t' read -r line; do
      IFS=$'\t' read -r _ _ _ _ _ pids starts <<<"$line"
      still_paused "$pids" "$starts" || continue
      printf '%s\n' "$line" >>"$kept" 2>/dev/null || {
        rm -f "$kept"
        exit 0
      }
    done <"$FROZEN"
    mv "$kept" "$FROZEN" 2>/dev/null || rm -f "$kept"
  ) 9>"$FROZEN_LOCK"
}

brake_held() {
  [[ -s $FROZEN ]] && awk -F '\t' '$2 == "brake" { found = 1 } END { exit !found }' "$FROZEN"
}

brake() {
  local picked key mb name pids starts pid i stopped=() stopped_starts=() refused=()
  if ! picked=$(omarchy-memory-top --pick "$brake_min_mb"); then
    log "brake: nothing unprotected over ${brake_min_mb}M to pause ($(metrics))"
    return
  fi
  IFS=$'\t' read -r key mb name pids starts <<<"$picked"
  IFS=, read -ra pids <<<"$pids"
  IFS=, read -ra starts <<<"$starts"
  # Locked from the first SIGSTOP until the record is written: resume rewrites
  # frozen.tsv under this lock and would drop a line appended without it,
  # leaving the group paused with nothing to resume it. No lock, no pause.
  {
    if ! flock -w 5 9; then
      log "brake: frozen.tsv stayed locked; left $name running ($(metrics))"
      return
    fi
    # Individual pids, never `kill -- -pgid`: a pgid can span cgroups, and
    # Hyprland's spans every app it launched.
    for i in "${!pids[@]}"; do
      pid=${pids[i]}
      # Exited since the pick, or its pid already reused.
      [[ $(start_time "$pid") == "${starts[i]}" ]] || continue
      if kill -STOP "$pid" 2>/dev/null; then
        stopped+=("$pid")
        stopped_starts+=("${starts[i]}")
      elif [[ -d /proc/$pid ]]; then
        refused+=("$pid")
      fi
    done
    # Half a group paused is not a pause, and saying it was would be a lie.
    if ((${#refused[@]})); then
      ((${#stopped[@]})) && kill -CONT "${stopped[@]}" 2>/dev/null
      log "brake: could not pause $name, pids ${refused[*]} refused SIGSTOP; left it running ($(metrics))"
      return
    fi
    if ((${#stopped[@]} == 0)); then
      log "brake: $name exited before it could be paused ($(metrics))"
      return
    fi
    pids=$(IFS=,; echo "${stopped[*]}")
    starts=$(IFS=,; echo "${stopped_starts[*]}")
    # A pause nothing has on record would outlive the watchdog: with the disk
    # full, say, the group runs on rather than stays stopped.
    if ! printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%F %T')" brake "$key" "$mb" "$name" "$pids" "$starts" >>"$FROZEN" 2>/dev/null; then
      kill -CONT "${stopped[@]}" 2>/dev/null
      log "brake: could not record the pause of $name in frozen.tsv; resumed it ($(metrics))"
      return
    fi
  } 9>"$FROZEN_LOCK"
  # After the lock is let go: the toast below runs in the background and would
  # hold it for as long as it runs.
  log "brake: paused $name (${mb}M, pids $pids) $(metrics)"
  omarchy-notification-send --urgency critical --glyph "$MEMORY_GLYPH" \
    "Memory brake: paused $name" \
    "${mb}M. Paused, not killed, before systemd-oomd had to kill something. Resume with: omarchy memory resume" >/dev/null 2>&1 &
}

omarchy-memory-oomd-kills &
kills_pid=$!
trap 'kill "$kills_pid" 2>/dev/null' EXIT
trap 'exit 0' TERM INT

last_warn=0
last_brake=0
quit=0
last_snapshot=0
warm=0
log "watching: warn at (swap>=${warn_swap_pct}% and ram>=${warn_swap_mem_pct}%) or (ram>=${warn_mem_pct}% and pressure>=${warn_psi}), brake at (swap>=${brake_swap_pct}% and ram>=${brake_swap_mem_pct}%) or (ram>=${brake_mem_pct}% and pressure>=${brake_psi})"

while true; do
  read_metrics

  prune_frozen

  # One sample is enough here: oomd waits 20s on pressure, this must not.
  # A pause stops the climb but frees nothing, so the lines stay crossed
  # after it; pausing the next group too would only spread the damage.
  if (((swap_pct >= brake_swap_pct && mem_pct >= brake_swap_mem_pct) ||
    (mem_pct >= brake_mem_pct && psi >= brake_psi))) &&
    ((EPOCHSECONDS - last_brake >= brake_gap)) && ! brake_held; then
    snapshot
    # A TERM waits for the brake to finish: stopping the watcher between a
    # SIGSTOP and its line in frozen.tsv would leave a pause that
    # omarchy-memory-resume, run when the watchdog is turned off, cannot see.
    trap 'quit=1' TERM INT
    brake
    trap 'exit 0' TERM INT
    ((quit)) && exit 0
    last_brake=$EPOCHSECONDS
  fi

  # Two samples in a row, so one spike doesn't raise a toast.
  if (((swap_pct >= warn_swap_pct && mem_pct >= warn_swap_mem_pct) ||
    (mem_pct >= warn_mem_pct && psi >= warn_psi))); then
    ((warm++))
    if ((EPOCHSECONDS - last_snapshot >= 10)); then
      snapshot
      last_snapshot=$EPOCHSECONDS
    fi
  else
    warm=0
  fi

  if ((warm >= 2 && EPOCHSECONDS - last_warn >= warn_gap)); then
    warn
    last_warn=$EPOCHSECONDS
  fi

  sleep "$interval"
done
