#!/bin/bash

# omarchy:summary=Stop the agent seat, closing every app on it

runtime="$XDG_RUNTIME_DIR/omarchy/agent-seat"
sandbox_supervisor=$(realpath -e "$(dirname "$0")/omarchy-agent-seat-sandbox")

process_start_time() {
  local stat fields

  [[ -r /proc/$1/stat ]] || return 1
  { stat=$(<"/proc/$1/stat"); } 2>/dev/null || return 1  # it may exit between the check and the read
  stat=${stat##*) }
  read -ra fields <<<"$stat"
  printf '%s\n' "${fields[19]}"
}

process_has_start() {
  local current

  current=$(process_start_time "$1") || return 1
  [[ $current == $2 ]]
}

supervisor_matches() {
  local pid="$1" start="$2" record="$3" marker="$4"
  local -a command

  process_has_start "$pid" "$start" || return 1
  mapfile -d '' -t command 2>/dev/null <"/proc/$pid/cmdline" || return 1
  [[ ${command[0]:-} == "/bin/bash" && ${command[1]:-} == $sandbox_supervisor && ${command[2]:-} == $record && ${command[3]:-} == $marker ]]
}

mkdir -p "$runtime/sandboxes"
exec 9>"$runtime/sandboxes.lock"
flock 9

omarchy-agent-seat-broker call '{"command":"stop"}' >/dev/null 2>&1 || true

# The broker replies just before it drops clients. Its control socket is
# removed only after that work, so wait for it before ending the sandboxes.
for _ in {1..50}; do
  [[ ! -S $runtime/control ]] && break
  sleep 0.01
done

shopt -s nullglob
for record in "$runtime"/sandboxes/sandbox.*; do
  read -r supervisor_pid supervisor_start marker bwrap_pid bwrap_start <"$record" || true
  # A PID is never enough: match its kernel start time and private command-line
  # marker as well, so a stale record cannot hit a reused PID.
  if [[ $supervisor_pid =~ ^[0-9]+$ && $supervisor_start =~ ^[0-9]+$ && -n $marker ]] && supervisor_matches "$supervisor_pid" "$supervisor_start" "$record" "$marker"; then
    sandbox_pids=("$supervisor_pid")
    sandbox_starts=("$supervisor_start")
    for ((index = 0; index < ${#sandbox_pids[@]}; index++)); do
      while read -r child; do
        child_start=$(process_start_time "$child") || continue
        sandbox_pids+=("$child")
        sandbox_starts+=("$child_start")
      done < <(pgrep -P "${sandbox_pids[index]}" 2>/dev/null || true)
    done

    # Kill leaves first. The verified bwrap process is included, while
    # --die-with-parent also catches anything that forked after this snapshot.
    for ((index = ${#sandbox_pids[@]} - 1; index >= 0; index--)); do
      if process_has_start "${sandbox_pids[index]}" "${sandbox_starts[index]}"; then
        kill -KILL "${sandbox_pids[index]}" 2>/dev/null || true
      fi
    done

    for _ in {1..100}; do
      sandbox_alive=false
      for ((index = 0; index < ${#sandbox_pids[@]}; index++)); do
        process_has_start "${sandbox_pids[index]}" "${sandbox_starts[index]}" && sandbox_alive=true
      done
      [[ $sandbox_alive == "false" ]] && break
      sleep 0.01
    done
    if [[ $sandbox_alive == "true" ]]; then
      echo "Could not stop every process in agent sandbox $marker" >&2
      stop_failed=true
    fi
  fi
  unlink "$record" 2>/dev/null || true
done

flock -u 9
exec 9>&-
if [[ ${stop_failed:-false} == "true" ]]; then
  exit 1
else
  echo "Agent seat: stopped"
fi
