#!/bin/bash

# omarchy:summary=Answer the memory agent's question
# omarchy:args=<approve|standdown|resolved>
# omarchy:examples=omarchy memory reply approve | omarchy memory reply standdown

case ${1:-} in
approve | standdown | resolved) ;;
*)
  echo "Usage: omarchy-memory-reply <approve|standdown|resolved>" >&2
  exit 1
  ;;
esac

state=$HOME/.local/state/omarchy/memory-watch
mkdir -p "$state"
echo "$1" >"$state/reply"
# The watcher reads this too: no more pauses and no more responders until
# memory has recovered, even once this ask is over.
[[ $1 == standdown ]] && touch "$state/standdown"
exit 0
