#!/bin/bash

# omarchy:summary=Take control of the agent seat's apps, or hand them back to the agent
# omarchy:args=[on|off]

# While the user has control, their own mouse and keyboard reach the agent's
# apps (to log in or solve a captcha) and the agent's input is refused.

case $1 in
on) args='{"user": true}' ;;
off) args='{"user": false}' ;;
"") args='{}' ;;
*)
  echo "Usage: omarchy agent seat control [on|off]" >&2
  exit 1
  ;;
esac

control=$(omarchy-agent-seat-broker call "{\"command\":\"control\",\"args\":$args}" | jq -r '.control') || exit 1

if [[ $control == "user" ]]; then
  omarchy-notification-send -t 3000 "Agent seat" "You have control of the agent's apps"
else
  omarchy-notification-send -t 3000 "Agent seat" "The agent has its apps back"
fi
echo "$control"
