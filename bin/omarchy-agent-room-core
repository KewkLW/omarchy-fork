#!/usr/bin/python3

# omarchy:summary=Shared core behind the agent room commands
# omarchy:args=whoami|list|send|pause|resume|name|log|watch|open-watchers [args...]
# omarchy:hidden=true

# The agent room lets agents running as this user talk to each other directly,
# with the whole conversation on show in the room pane on workspace 9, where the
# user can join in. There is no daemon: identity comes from the process tree,
# each agent's pty relay types what it is sent into its prompt, and every
# message is appended to a log the room pane follows. The
# omarchy-agent-{list,send,name,log} wrappers all land here, and each relay
# imports this file to act for its agent.

import argparse
import datetime
import fcntl
import glob
import json
import os
import random
import re
import select
import shutil
import socket
import subprocess
import sys
import time

# The agents omarchy-default-agent knows. A process counts as an agent when its
# name is one of these, or when it is an interpreter running a script with one
# of these names (npm-installed agents run as `node .../bin/<agent>`).
AGENT_KINDS = {
    "agy", "claude", "codex", "copilot", "crush", "cursor-agent", "grok",
    "hermes", "muse", "omp", "opencode", "openclaw", "ori", "pi",
}
INTERPRETERS = re.compile(r"^(node|nodejs|bun|deno|python[0-9.]*)$")

BASE = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "omarchy")
RUNTIME = os.path.join(BASE, "agents")
# Each relay's agent drops its room requests here for the relay to carry out.
# It is the one place a sandboxed agent needs to be able to write.
OUTBOXES = os.path.join(BASE, "agent-outbox")
OUTBOX_ENV = "OMARCHY_AGENT_ROOM_OUTBOX"
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "omarchy", "agents")
LOG_DIR = os.path.join(STATE, "log")
LOG_DAYS = 30
USER = "user"
PAUSED = os.path.join(RUNTIME, "paused")
# The pid namespace the relays run in, which is the one the room's pids mean
# anything in. A caller in another one (a sandbox) can't see the process tree.
PIDNS = os.path.join(RUNTIME, "pidns")

# Two agents answering each other can talk forever. Past this many messages a
# minute an agent is told to slow down, and the user can pause the room outright.
RATE_LIMIT = 10

os.umask(0o077)


class RoomError(Exception):
    pass


def fail(message):
    raise RoomError(message)


# Set by a relay while it carries out a request from its own agent.
CALLER_OVERRIDE = None


# Processes

def read_stat(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            data = f.read()
    except OSError:
        return None
    # comm is parenthesised and may itself contain spaces or parentheses.
    close = data.rindex(")")
    comm = data[data.index("(") + 1 : close]
    fields = data[close + 2 :].split()
    return {"comm": comm, "ppid": int(fields[1]), "start": int(fields[19])}


def cmdline(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
    except OSError:
        return []


def agent_kind(pid, stat):
    if stat["comm"] in AGENT_KINDS:
        return stat["comm"]
    args = cmdline(pid)
    if args and os.path.basename(args[0]) in AGENT_KINDS:
        return os.path.basename(args[0])
    if args and INTERPRETERS.match(os.path.basename(args[0])):
        for arg in args[1:]:
            if arg.startswith("-"):
                continue
            name = re.sub(r"\.(c?m?js|ts|py)$", "", os.path.basename(arg))
            return name if name in AGENT_KINDS else None
    return None


def alive(pid, start):
    stat = read_stat(pid)
    return stat is not None and stat["start"] == start


def my_pidns():
    try:
        return os.readlink("/proc/self/ns/pid")
    except OSError:
        return None


# Identity: the nearest agent above the caller, or the user when there is none.
# A pty relay registers its agent up front, so a registered pid wins even when
# the agent runs under a name this list doesn't know.

def caller():
    if CALLER_OVERRIDE is not None:
        return CALLER_OVERRIDE
    try:
        with open(PIDNS) as f:
            host = f.read().strip()
    except OSError:
        host = None
    if host and host != my_pidns():
        fail("You're in a sandbox that hides other processes, so the room can't tell who you are. "
             "Agents started with omarchy agent talk through their relay, which works from any sandbox.")
    return identify(os.getppid())


def identify(pid):
    live = agents()
    registered = {a["pid"]: a for a in live}
    # A relay delivering for its agent speaks as that agent.
    relays = {a["relay_pid"]: a for a in live if a.get("relay_pid")}
    while pid > 1:
        stat = read_stat(pid)
        if stat is None:
            break
        if pid in registered:
            return registered[pid]
        if pid in relays:
            return relays[pid]
        kind = agent_kind(pid, stat)
        if kind:
            return register(kind, pid, stat["start"])
        pid = stat["ppid"]
    return {"id": USER, "name": USER, "kind": USER}


def agent_dir(agent_id):
    return os.path.join(RUNTIME, agent_id)


def register(kind, pid, start, relay_pid=None):
    agent_id = f"{kind}-{pid}"
    path = agent_dir(agent_id)
    meta_path = os.path.join(path, "agent.json")
    existing = load_json(meta_path)
    if existing and existing.get("start") == start:
        return existing
    # A leftover directory under a recycled pid belongs to a dead agent.
    shutil.rmtree(path, ignore_errors=True)
    os.makedirs(path, mode=0o700, exist_ok=True)
    try:
        cwd = os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        cwd = None
    meta = {
        "id": agent_id,
        "kind": kind,
        "pid": pid,
        "start": start,
        "name": None,
        "cwd": cwd,
        "relay": relay_pid is not None,
        "relay_pid": relay_pid,
        "pidns": my_pidns(),
        "since": now(),
    }
    write_json(meta_path, meta)
    return meta


def agents():
    found = []
    try:
        entries = sorted(os.listdir(RUNTIME))
    except FileNotFoundError:
        return found
    for entry in entries:
        meta = load_json(os.path.join(RUNTIME, entry, "agent.json"))
        if meta is None:
            continue
        # Only a caller that sees the same processes can tell a dead agent.
        if meta.get("pidns") and meta["pidns"] != my_pidns():
            found.append(meta)
        elif alive(meta["pid"], meta["start"]):
            found.append(meta)
        else:
            shutil.rmtree(os.path.join(RUNTIME, entry), ignore_errors=True)
    return found


def resolve(target, sender):
    if target == USER:
        return [{"id": USER, "name": USER, "kind": USER}]
    live = agents()
    if target == "all":
        return [a for a in live if a["id"] != sender["id"] and a.get("relay")]
    for key in ("id", "name"):
        matches = [a for a in live if a.get(key) == target]
        if matches:
            return matches[:1]
    matches = [a for a in live if a["kind"] == target or str(a["pid"]) == target]
    if len(matches) == 1:
        return matches
    if len(matches) > 1:
        fail(f"More than one {target} is running; address one by id: " + ", ".join(a["id"] for a in matches))
    fail(f"No agent called {target}. See: omarchy agent list")


# Files

def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def load_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_json(path, data):
    temp = f"{path}.{os.getpid()}.tmp"
    with open(temp, "w") as f:
        json.dump(data, f)
    os.replace(temp, path)


def label(agent):
    return agent.get("name") or agent["id"]


def append_log(message):
    os.makedirs(LOG_DIR, mode=0o700, exist_ok=True)
    day = message["time"][:10]
    with open(os.path.join(LOG_DIR, f"{day}.jsonl"), "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write(json.dumps(message) + "\n")
    cutoff = (datetime.date.today() - datetime.timedelta(days=LOG_DAYS)).isoformat()
    for name in os.listdir(LOG_DIR):
        if name.endswith(".jsonl") and name[:10] < cutoff:
            os.unlink(os.path.join(LOG_DIR, name))


def recent_from(sender_id, seconds):
    files = log_files(False)
    if not files:
        return 0
    cutoff = (datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(seconds=seconds)).isoformat(timespec="seconds").replace("+00:00", "Z")
    count = 0
    with open(files[-1]) as f:
        for line in f:
            try:
                message = json.loads(line)
            except ValueError:
                continue
            if message.get("from") == sender_id and message.get("time", "") >= cutoff and "text" in message:
                count += 1
    return count


# Messages go straight into the recipient's prompt through its pty relay. The
# relay works out who is sending from the connection itself and writes the
# sender into what it types, so a message can't claim to be from someone else.
def type_into(recipient, text):
    if not recipient.get("relay"):
        return False
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.settimeout(5)
        sock.connect(os.path.join(agent_dir(recipient["id"]), "input.sock"))
        sock.sendall(text.encode())
        sock.shutdown(socket.SHUT_WR)
        return sock.recv(16).startswith(b"ok")
    except OSError:
        return False
    finally:
        sock.close()


def notify_user(message):
    subprocess.run(
        ["omarchy-notification-send", "-g", "󰚩", f"{message['from_name']} says", message["text"][:300]],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


# Commands

def cmd_whoami(args):
    me = caller()
    print(json.dumps(me) if args.json else me["id"])


# Subagents
#
# Claude Code runs its subagents inside the main claude process, so they have no
# process or terminal of their own to find. Claude Code does keep a live record
# of them on disk: sessions/<pid>.json ties a running claude to its session, and
# each subagent writes its transcript to <session>/subagents/agent-<id>.jsonl
# with its task beside it in agent-<id>.meta.json. None of that is a published
# interface, so everything here reads it defensively, and the room works the
# same without it.

CLAUDE_HOME = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")

# A background subagent can end its turn and be woken again later, so it only
# counts as finished once its last turn has ended and it has been quiet this long.
SUBAGENT_QUIET = 120
SUBAGENT_SHORT_ID = 8


def claude_sessions():
    found = []
    for path in glob.glob(os.path.join(CLAUDE_HOME, "sessions", "*.json")):
        session = load_json(path)
        try:
            pid, start = int(session["pid"]), int(session["procStart"])
        except (TypeError, KeyError, ValueError):
            continue
        if session.get("sessionId") and alive(pid, start):
            found.append({**session, "pid": pid, "start": start})
    return found


# Claude sessions started by hand join the room as soon as anything looks, so
# their subagents have a parent to hang from.
def discover_claude():
    known = {a["pid"] for a in agents()}
    for session in claude_sessions():
        if session["pid"] not in known:
            register("claude", session["pid"], session["start"])


def last_record(path):
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 65536))
            lines = f.read().splitlines()
    except OSError:
        return None
    for line in reversed(lines):
        try:
            record = json.loads(line)
        except ValueError:
            continue
        if record.get("type") in ("assistant", "user"):
            return record
    return None


def subagent_finished(path):
    record = last_record(path)
    ended = record is not None and record["type"] == "assistant" and (record.get("message") or {}).get("stop_reason") == "end_turn"
    try:
        quiet = time.time() - os.path.getmtime(path) >= SUBAGENT_QUIET
    except OSError:
        return True
    return ended and quiet


def subagents(parent=None):
    found = []
    for session in claude_sessions():
        parent_id = f"claude-{session['pid']}"
        if parent and parent["id"] != parent_id:
            continue
        pattern = os.path.join(CLAUDE_HOME, "projects", "*", session["sessionId"], "subagents", "agent-*.jsonl")
        for path in sorted(glob.glob(pattern), key=os.path.getmtime):
            agent_id = os.path.basename(path)[len("agent-"):-len(".jsonl")]
            meta = load_json(path[: -len(".jsonl")] + ".meta.json") or {}
            found.append({
                "id": f"{parent_id}/{agent_id[:SUBAGENT_SHORT_ID]}",
                "parent": parent_id,
                "agent_id": agent_id,
                "type": meta.get("agentType") or "subagent",
                "description": meta.get("description") or "",
                "model": meta.get("model"),
                "background": meta.get("requestShape") == "background",
                "transcript": path,
                "finished": subagent_finished(path),
            })
    return found


def find_subagent(target):
    parent_id, _, prefix = target.partition("/")
    matches = [s for s in subagents() if s["parent"] == parent_id and s["agent_id"].startswith(prefix)]
    if len(matches) != 1:
        fail(f"No single subagent {target}. See: omarchy agent list")
    return matches[0]


def cmd_list(args):
    me = caller()
    discover_claude()
    rows = []
    helpers = subagents()
    for agent in agents():
        mine = [s for s in helpers if s["parent"] == agent["id"] and (args.all or not s["finished"])]
        rows.append({**agent, "you": agent["id"] == me["id"], "subagents": mine})
    if args.json:
        print(json.dumps(rows, indent=2))
        return
    if not rows:
        print("No agents running")
        return
    for row in rows:
        name = f" ({row['name']})" if row["name"] else ""
        you = "  <- you" if row["you"] else ""
        # Only agents started through omarchy agent run under the relay that
        # types messages in; the rest can talk but can't be talked to.
        deaf = "" if row["relay"] else "  (can send, can't receive)"
        print(f"{row['id']}{name}  {row['cwd'] or ''}{deaf}{you}")
        for sub in row["subagents"]:
            done = "  (finished)" if sub["finished"] else ""
            print(f"  └ {sub['id']}  {sub['type']}  {sub['description']}{done}")


def cmd_send(args):
    text = " ".join(args.message) if args.message else sys.stdin.read()
    text = text.strip()
    if not text:
        fail("Nothing to send")
    sender = caller()
    if "/" in args.to:
        sub = find_subagent(args.to)
        args.to = sub["parent"]
        text = f'For your subagent "{sub["description"] or sub["type"]}" ({sub["agent_id"]}), pass this on to it: {text}'
    if sender["id"] != USER:
        if os.path.exists(PAUSED):
            fail("The user has paused the agent room; nothing is delivered until they resume it")
        if recent_from(sender["id"], 60) >= RATE_LIMIT:
            fail(f"More than {RATE_LIMIT} messages in a minute; slow down, or stop if you and another agent are going back and forth")
    recipients = resolve(args.to, sender)
    if args.to != "all" and recipients[0]["id"] == sender["id"]:
        fail("That's you")
    if args.to == "all" and not recipients:
        fail("No other agent in the room can be spoken to")
    if recipients[0]["id"] != USER and args.to != "all" and not recipients[0].get("relay"):
        fail(f"{recipients[0]['id']} wasn't started with omarchy agent, so it can't be spoken to")

    message = {
        "id": f"m-{int(time.time() * 1000)}-{random.randrange(10000):04d}",
        "time": now(),
        "from": sender["id"],
        "from_name": label(sender),
        "to": args.to if args.to == "all" else recipients[0]["id"],
        "text": text,
    }
    missed = []
    for recipient in recipients:
        if recipient["id"] == USER:
            notify_user(message)
        elif not type_into(recipient, text):
            missed.append(recipient["id"])
    if missed:
        message["undelivered"] = missed
    append_log(message)
    if missed:
        fail("Not delivered to " + ", ".join(missed))
    print(message["id"])


def room_event(text):
    append_log({"time": now(), "event": text})


def cmd_pause(args):
    if caller()["id"] != USER:
        fail("Only the user can pause or resume the room")
    if args.command == "pause":
        os.makedirs(RUNTIME, mode=0o700, exist_ok=True)
        open(PAUSED, "w").close()
        room_event("The user paused the room. Agents can't message anyone until it resumes.")
    else:
        try:
            os.unlink(PAUSED)
        except FileNotFoundError:
            pass
        room_event("The user resumed the room.")


def cmd_name(args):
    me = caller()
    if me["id"] == USER:
        fail("Only agents take names; you are already `user`")
    if not re.fullmatch(r"[a-z][a-z0-9-]{0,31}", args.name) or args.name in (USER, "all") or args.name in AGENT_KINDS:
        fail("Names are lowercase letters, digits and dashes, and can't be user, all, or an agent kind")
    if any(a["name"] == args.name and a["id"] != me["id"] for a in agents()):
        fail(f"Another agent is already called {args.name}")
    meta_path = os.path.join(agent_dir(me["id"]), "agent.json")
    meta = load_json(meta_path)
    meta["name"] = args.name
    write_json(meta_path, meta)
    print(args.name)


def log_files(all_days):
    try:
        names = sorted(n for n in os.listdir(LOG_DIR) if n.endswith(".jsonl"))
    except FileNotFoundError:
        return []
    if not all_days:
        today = datetime.date.today().isoformat()
        names = [n for n in names if n[:10] >= today] or names[-1:]
    return [os.path.join(LOG_DIR, n) for n in names]


def show(line, as_json):
    if as_json:
        print(line, end="" if line.endswith("\n") else "\n", flush=True)
        return
    try:
        message = json.loads(line)
    except ValueError:
        return
    when = datetime.datetime.fromisoformat(message["time"].replace("Z", "+00:00")).astimezone().strftime("%H:%M")
    if "event" in message:
        print(f"{when}  -- {message['event']}", flush=True)
        return
    sender, to = message["from_name"], message["to"]
    if sys.stdout.isatty():
        sender, to = paint(message["from"], sender), paint(to, to)
    # Continuation lines are indented under the text, so a long message still
    # reads as one message in a busy room.
    text = message["text"].replace("\n", "\n       ")
    missed = f"  [not delivered to {', '.join(message['undelivered'])}]" if message.get("undelivered") else ""
    print(f"{when}  {sender} -> {to}: {text}{missed}", flush=True)


# Each participant keeps one terminal colour, so a busy room reads at a glance.
def paint(key, text):
    if key == USER:
        return f"\033[1m{text}\033[0m"
    colour = 31 + sum(key.encode()) % 6
    return f"\033[{colour}m{text}\033[0m"


def cmd_log(args):
    files = log_files(args.all)
    for path in files:
        with open(path) as f:
            for line in f:
                show(line, args.json)
    if not args.follow:
        return
    path = files[-1] if files else None
    offset = os.path.getsize(path) if path else 0
    while True:
        latest = log_files(False)
        if latest and latest[-1] != path:
            path, offset = latest[-1], 0
        if path and os.path.exists(path) and os.path.getsize(path) > offset:
            with open(path) as f:
                f.seek(offset)
                for line in f:
                    show(line, args.json)
                offset = f.tell()
        time.sleep(0.25)


# Requests an agent can make of its relay. The relay runs outside any sandbox the
# agent is in, and knows which agent it runs, so it answers for it.
RELAYED = {"whoami", "list", "send", "name", "pause", "resume"}


def forward(outbox, argv):
    if argv[0] == "send" and len(argv) == 2:
        argv.append(sys.stdin.read())
    request = f"{time.time_ns()}-{os.getpid()}"
    write_json(os.path.join(outbox, f"{request}.req"), {"argv": argv})
    answer = os.path.join(outbox, f"{request}.out")
    deadline = time.monotonic() + 60
    while time.monotonic() < deadline:
        reply = load_json(answer)
        if reply is not None:
            os.unlink(answer)
            sys.stdout.write(reply["out"])
            sys.stderr.write(reply["err"])
            sys.exit(reply["code"])
        time.sleep(0.05)
    fail("Your relay didn't answer")


# Watching a subagent

def summarise(tool):
    given = tool.get("input") or {}
    for key in ("command", "file_path", "path", "pattern", "url", "description", "prompt"):
        if isinstance(given.get(key), str):
            return given[key]
    return json.dumps(given)


def result_text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(part.get("text", "") for part in content if isinstance(part, dict))
    return ""


def clip(text, lines, width):
    rows = [row[:width] for row in text.strip().splitlines()[:lines]]
    more = len(text.strip().splitlines()) - lines
    return rows + ([f"... {more} more lines"] if more > 0 else [])


DIM, BOLD, RESET = "\033[2m", "\033[1m", "\033[0m"


def render(record, width):
    kind = record.get("type")
    message = record.get("message") or {}
    content = message.get("content")
    when = ""
    if record.get("timestamp"):
        when = datetime.datetime.fromisoformat(record["timestamp"].replace("Z", "+00:00")).astimezone().strftime("%H:%M")
    out = []
    if kind == "user" and isinstance(content, str):
        out.append(f"{when}  {BOLD}Task{RESET}")
        out += [f"       {row}" for row in clip(content, 12, width)]
    elif kind == "user" and isinstance(content, list):
        for part in content:
            if isinstance(part, dict) and part.get("type") == "tool_result":
                out += [f"       {DIM}{row}{RESET}" for row in clip(result_text(part.get("content")), 4, width)]
    elif kind == "assistant" and isinstance(content, list):
        for part in content:
            if not isinstance(part, dict):
                continue
            if part.get("type") == "text" and part.get("text", "").strip():
                out += [f"{when}  {row}" if i == 0 else f"       {row}" for i, row in enumerate(clip(part["text"], 40, width))]
            elif part.get("type") == "tool_use":
                out.append(f"{when}  {BOLD}> {part.get('name')}{RESET}  {summarise(part).splitlines()[0][:width] if summarise(part) else ''}")
    return out


def cmd_watch(args):
    sub = find_subagent(args.subagent)
    title = f"{sub['parent']} > {sub['description'] or sub['type']}"
    sys.stdout.write(f"\033]0;{title}\007")
    width = max(40, shutil.get_terminal_size((100, 30)).columns - 8)
    model = f" · {sub['model']}" if sub["model"] else ""
    print(f"{BOLD}{sub['parent']} > {sub['type']}{RESET}  {sub['description']}{model}")
    print(f"{DIM}{sub['id']}  (read-only: speak to it with @{sub['id']} in the room){RESET}\n", flush=True)

    # Opened partway through a long run, start from the recent end.
    def show_lines(lines):
        for line in lines:
            try:
                rows = render(json.loads(line), width)
            except ValueError:
                continue
            if rows:
                print("\n".join(rows), flush=True)

    with open(sub["transcript"]) as f:
        lines = f.read().split("\n")
        offset = f.tell()
    partial = lines.pop()
    show_lines(lines[-200:])

    while True:
        with open(sub["transcript"]) as f:
            f.seek(offset)
            partial += f.read()
            offset = f.tell()
        *complete, partial = partial.split("\n")
        show_lines(complete)
        parent_alive = any(f"claude-{s['pid']}" == sub["parent"] for s in claude_sessions())
        if not parent_alive or subagent_finished(sub["transcript"]):
            break
        time.sleep(0.5)
    print(f"\n{DIM}-- finished --{RESET}", flush=True)
    if args.linger and sys.stdin.isatty():
        print(f"{DIM}Closing in {args.linger}s, or press Enter.{RESET}", flush=True)
        select.select([sys.stdin], [], [], args.linger)


# Run by the room pane: every running subagent gets a terminal on the agent
# workspace, once, for as long as the pane is open.
MAX_WATCHERS = 8


def cmd_open_watchers(args):
    # Each subagent opens once: one the user closes stays closed.
    opened = set()
    while True:
        running = [s for s in subagents() if not s["finished"]]
        showing = sum(1 for s in running if s["agent_id"] in opened)
        for sub in running:
            if sub["agent_id"] in opened or showing >= MAX_WATCHERS:
                continue
            opened.add(sub["agent_id"])
            showing += 1
            subprocess.Popen(
                ["omarchy-launch-tui", "--app-id=org.omarchy.agent-watch", "omarchy-agent-watch", "--linger", "60", sub["id"]],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
            )
        time.sleep(args.every)


def build_parser():
    parser = argparse.ArgumentParser(prog="omarchy-agent-room-core")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("whoami")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_whoami)

    p = sub.add_parser("list")
    p.add_argument("--json", action="store_true")
    p.add_argument("--all", action="store_true", help="include finished subagents")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("send")
    p.add_argument("to")
    p.add_argument("message", nargs="*")
    p.set_defaults(func=cmd_send)

    for command in ("pause", "resume"):
        p = sub.add_parser(command)
        p.set_defaults(func=cmd_pause)

    p = sub.add_parser("name")
    p.add_argument("name")
    p.set_defaults(func=cmd_name)

    p = sub.add_parser("watch")
    p.add_argument("--linger", type=int, default=0)
    p.add_argument("subagent")
    p.set_defaults(func=cmd_watch)

    p = sub.add_parser("open-watchers")
    p.add_argument("--every", type=float, default=3)
    p.set_defaults(func=cmd_open_watchers)

    p = sub.add_parser("log")
    p.add_argument("--follow", action="store_true")
    p.add_argument("--all", action="store_true")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_log)

    return parser


def main():
    argv = sys.argv[1:]
    try:
        outbox = os.environ.get(OUTBOX_ENV)
        if outbox and argv and argv[0] in RELAYED:
            forward(outbox, argv)
        args = build_parser().parse_args(argv)
        args.func(args)
    except RoomError as error:
        print(error, file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(0)


if __name__ == "__main__":
    main()
