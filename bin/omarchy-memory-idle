#!/usr/bin/python3
# omarchy:summary=Ask idle Claude Code sessions if they are done, close the done ones, and report
# omarchy:args=[--dry-run] [--check] [--report] [--only <session>] [--idle <minutes>] [--min-mb <MB>] [--timeout <seconds>]
# omarchy:examples=omarchy memory idle | omarchy memory idle --dry-run | omarchy memory idle --idle 60 | omarchy memory idle --report

# The watcher runs this when a session qualifies, or memory runs short. Every
# local Claude session at least --idle minutes idle and --min-mb big, or
# OMARCHY_MEMORY_IDLE_BIG_MB (200) big and OMARCHY_MEMORY_IDLE_BIG_MIN (5)
# minutes idle, is asked, through omarchy-memory-message, whether its work is
# finished and saved to the vault (saving it first if not), and answers with a
# fixed IDLE-REPLY block read back from its transcript. A session whose answer
# is "done" with its work saved, or not worth saving, is closed: its claude
# process gets SIGTERM, and its terminal goes too unless it is the window in
# focus. Everything else keeps running. A closed session stays resumable with
# claude --resume, and the report gives the command.
#
# No answer within --timeout leaves the session running, unless
# OMARCHY_MEMORY_IDLE_CLOSE_SILENT=1. Sessions working right now, frozen by the
# brake, or that answered "working" or "waiting" within the last
# OMARCHY_MEMORY_IDLE_REASK hours (default 6), or did not answer in that
# time, are not asked, nor is the one in the window in focus; the report lists
# them with what they last did, and the other agents too. --check asks
# nothing: it exits 0 when some session would be asked, 1 when none would.
#
# Every run writes a report, by project: each project with its agents under
# it (orchestrator first), what each is for, what it has left, who it waits
# on and what it last said, then the sessions closed in this run and the ones
# that closed or exited in the last OMARCHY_MEMORY_IDLE_REPORT_HOURS (24),
# with their last words and the command to resume them. The newest report is
# also reports/idle-latest.html. --report asks and closes nothing and only
# writes the report.

import glob
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
from datetime import datetime

STATE = os.path.expanduser("~/.local/state/omarchy/memory-watch")
IDLE_DIR = os.path.join(STATE, "idle")
ANSWERS = os.path.join(IDLE_DIR, "answers.json")
CLOSED = os.path.join(IDLE_DIR, "closed.jsonl")
SEEN = os.path.join(IDLE_DIR, "seen.json")
LOG = os.path.join(STATE, "watch.log")
CODEX_HOME = os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex")
PROJECT_ROOTS = ("Work", "build", "Projects")
NOISE = ("<", "Stop hook feedback", "[Agent room]", "[Memory watchdog idle sweep", "[Request interrupted", "Caveat:", "# AGENTS.md")
CLAUDE_HOME = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
TERMINALS = {"foot", "alacritty", "ghostty", "kitty", "wezterm-gui", "konsole", "xterm"}
SHELLS = {"bash", "zsh", "fish", "sh", "dash"}
FIELDS = ("vault", "doing", "left", "waiting-on")
MEMORY_GLYPH = "\U000f035b"


def arg(name, default):
    if name in sys.argv:
        try:
            return float(sys.argv[sys.argv.index(name) + 1])
        except (IndexError, ValueError):
            sys.exit(f"omarchy-memory-idle: {name} needs a number")
    return default


DRY = "--dry-run" in sys.argv
CHECK = "--check" in sys.argv
REPORT = "--report" in sys.argv
ONLY = sys.argv[sys.argv.index("--only") + 1] if "--only" in sys.argv[:-1] else None
IDLE_MIN = arg("--idle", float(os.environ.get("OMARCHY_MEMORY_IDLE_ASK_MIN", 30)))
MIN_MB = arg("--min-mb", float(os.environ.get("OMARCHY_MEMORY_IDLE_MIN_MB", 100)))
BIG_MB = float(os.environ.get("OMARCHY_MEMORY_IDLE_BIG_MB", 200))
BIG_MIN = float(os.environ.get("OMARCHY_MEMORY_IDLE_BIG_MIN", 5))
TIMEOUT = arg("--timeout", float(os.environ.get("OMARCHY_MEMORY_IDLE_TIMEOUT", 600)))
REASK = float(os.environ.get("OMARCHY_MEMORY_IDLE_REASK", 6)) * 3600
CLOSE_SILENT = os.environ.get("OMARCHY_MEMORY_IDLE_CLOSE_SILENT") == "1"
POLL = float(os.environ.get("OMARCHY_MEMORY_IDLE_POLL", 5))
REPORT_HOURS = float(os.environ.get("OMARCHY_MEMORY_IDLE_REPORT_HOURS", 24))


def log(line):
    line = f"{datetime.now():%F %T} idle: {line}"
    print(line, file=sys.stderr)
    try:
        with open(LOG, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def ago(seconds):
    seconds = int(seconds or 0)
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if seconds >= size:
            return f"{seconds // size}{unit}"
    return f"{seconds}s"


def stat(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            s = f.read()
    except OSError:
        return None
    rest = s[s.rindex(")") + 2:].split()
    return {"comm": s[s.index("(") + 1: s.rindex(")")], "ppid": int(rest[1]), "start": rest[19]}


def session_file(pid):
    try:
        with open(os.path.join(CLAUDE_HOME, "sessions", f"{pid}.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def ancestors():
    out, pid = set(), os.getpid()
    while pid and pid > 1:
        out.add(pid)
        s = stat(pid)
        pid = s["ppid"] if s else 0
    return out


def focused_pid():
    try:
        return json.loads(subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True,
                                         text=True, timeout=5).stdout or "{}").get("pid")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def under(pid, parent):
    # Whether parent is pid or one of its ancestors.
    while parent and pid and pid > 1:
        if pid == parent:
            return True
        s = stat(pid)
        pid = s["ppid"] if s else 0
    return False


def frozen_pids():
    pids = set()
    try:
        with open(os.path.join(STATE, "frozen.tsv")) as f:
            for line in f:
                cols = line.rstrip("\n").split("\t")
                if len(cols) > 5:
                    pids.update(int(p) for p in cols[5].split(",") if p.isdigit())
    except OSError:
        pass
    return pids


def load_answers():
    try:
        with open(ANSWERS) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_answers(answers):
    tmp = ANSWERS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(answers, f, indent=1)
    os.replace(tmp, ANSWERS)


def entries(path, offset=0):
    # Whole JSON lines only: one still being written is read on the next poll.
    try:
        with open(path, "rb") as f:
            f.seek(offset)
            data = f.read()
    except (OSError, TypeError):
        return []
    out = []
    for line in data.split(b"\n")[:-1]:
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


def texts(entry, role, tools=True):
    if entry.get("type") == "response_item":
        # A Codex rollout.
        item = entry.get("payload") or {}
        if item.get("type") != "message" or item.get("role") != role:
            return []
        return [c.get("text") or "" for c in item.get("content") or [] if isinstance(c, dict)]
    if entry.get("type") != role:
        return []
    content = (entry.get("message") or {}).get("content")
    if isinstance(content, str):
        return [content]
    out = []
    for block in content or []:
        if block.get("type") == "text":
            out.append(block.get("text") or "")
        elif tools and role == "assistant" and block.get("type") == "tool_use":
            # A session may answer the sender with SendMessage instead.
            out += [v for v in (block.get("input") or {}).values() if isinstance(v, str)]
    return out


def parse_reply(text):
    at = text.rfind("IDLE-REPLY:")
    if at < 0:
        return None
    lines = text[at:].splitlines()
    verdict = lines[0].split(":", 1)[1].strip().strip("*`").lower()
    verdict = next((w for w in ("done", "working", "waiting") if verdict.startswith(w)), verdict)
    reply = {"verdict": verdict}
    for line in lines[1:]:
        key, _, value = line.strip().strip("*`").partition(":")
        if key.strip().lower() in FIELDS:
            reply[key.strip().lower()] = value.strip().strip("*`")
    return reply


def clip(text, size):
    text = " ".join((text or "").split())
    return text if len(text) <= size else text[:size - 1].rstrip() + "\u2026"


def summary(path):
    # What a session was started for (its first real prompt) and the last thing
    # it said that was not an answer to the sweep: its closing words.
    if not path or not os.path.exists(path):
        return "", ""
    purpose = said = ""
    for e in entries(path)[:400] if os.path.getsize(path) < 300_000 else head_entries(path):
        purpose = next((t for t in texts(e, "user") if t.strip() and not t.lstrip().startswith(NOISE)), "")
        if purpose:
            break
    for e in entries(path, max(0, os.path.getsize(path) - 400_000)):
        for t in texts(e, "assistant", tools=False):
            if t.strip() and "IDLE-REPLY:" not in t:
                said = t
    # A board worker's prompt opens with boilerplate; its bounty title says more.
    bounty = re.search(r"bounty #(\d+).*?Title: (.+?)\s+- Type ", " ".join(purpose.split()))
    if bounty:
        purpose = f"Bounty #{bounty.group(1)}: {bounty.group(2)}"
    # The last words keep their line breaks: they are often a whole result.
    said = re.sub(r"\n{3,}", "\n\n", said.strip())
    return clip(purpose, 300), said if len(said) <= 6000 else said[:6000].rstrip() + "\u2026"


def head_entries(path):
    try:
        with open(path, "rb") as f:
            data = f.read(300_000)
    except OSError:
        return []
    out = []
    for line in data.split(b"\n")[:-1]:
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


def proc_env(pid):
    try:
        with open(f"/proc/{pid}/environ", "rb") as f:
            pairs = (v.split("=", 1) for v in f.read().decode(errors="replace").split("\0") if v.startswith("OMARCHY_"))
            return {k: v for k, v in pairs}
    except (OSError, ValueError):
        return {}


def project_of(cwd, env):
    # The project an agent was spawned for, else the one its directory belongs
    # to: ~/Work/<project>-wt/<task>, ~/Work/<project>-board, ~/build/<project>.
    if env.get("OMARCHY_PROJECT"):
        return env["OMARCHY_PROJECT"]
    home = os.path.expanduser("~")
    parts = cwd[len(home) + 1:].split("/") if (cwd or "").startswith(home + "/") else []
    if len(parts) > 1 and parts[0] in PROJECT_ROOTS:
        return re.sub(r"-(wt|board)$", "", parts[1])
    return ""


def started_at(start):
    # A /proc start time in clock ticks, as seconds since the epoch.
    try:
        with open("/proc/stat") as f:
            boot = next(int(line.split()[1]) for line in f if line.startswith("btime"))
        return boot + int(start) / os.sysconf("SC_CLK_TCK")
    except (OSError, ValueError, StopIteration):
        return 0


def find_transcript(agent, started):
    # For agents with no session file (headless workers, Codex): the transcript
    # in their directory that began nearest to when the process started.
    if agent["kind"] == "claude":
        files = glob.glob(os.path.join(CLAUDE_HOME, "projects", re.sub(r"[^A-Za-z0-9]", "-", agent["cwd"] or ""), "*.jsonl"))
    elif agent["kind"] == "codex":
        files = glob.glob(os.path.join(CODEX_HOME, "sessions", "*", "*", "*", "rollout-*.jsonl"))
    else:
        return None
    best = None
    for path in files:
        try:
            if os.path.getmtime(path) < started - 5:
                continue
            with open(path, "rb") as f:
                top = f.read(65536).decode(errors="replace")
        except OSError:
            continue
        if agent["kind"] == "codex" and f'"cwd":"{agent["cwd"]}"' not in top:
            continue
        stamp = re.search(r'"timestamp":"([^"]+)"', top)
        try:
            began = datetime.fromisoformat(stamp.group(1).replace("Z", "+00:00")).timestamp()
        except (AttributeError, ValueError):
            began = os.path.getmtime(path)
        if best is None or abs(began - started) < best[0]:
            best = (abs(began - started), path)
    return best[1] if best else None


def clock(at):
    then = datetime.fromtimestamp(at)
    text = then.strftime("%I:%M %p").lstrip("0").lower()
    return text if then.date() == datetime.now().date() else f"{then:%b} {then.day}, {text}"


def load_closed():
    out = []
    try:
        with open(CLOSED) as f:
            for line in f:
                try:
                    out.append(json.loads(line))
                except ValueError:
                    pass
    except OSError:
        pass
    return out


def load_seen():
    try:
        with open(SEEN) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def card(a):
    # One agent as the report shows it.
    r = a.get("reply") or a.get("prior") or {}
    old = f" (said {ago(time.time() - r['at'])} ago)" if r.get("at") else ""
    if a["group"] == "closed":
        state, kind = f"closed {clock(time.time())}", "closed"
    elif a.get("asked_at"):
        state, kind = (r.get("verdict") or a.get("outcome") or "kept"), "kept"
    else:
        state = a.get("outcome") or "running"
        kind = "working" if state in ("working", "running") or state.startswith("running") else "idle"
    return {
        "key": a["key"], "label": a["label"], "name": a.get("name") or a["id"], "role": a.get("role") or "",
        "kind": a["kind"], "project": a["project"], "cwd": a["cwd"], "mb": a["total_mb"],
        "idle": ago(a["idle_s"]) if a.get("idle_s") else "", "state": state, "class": kind,
        "doing": r.get("doing") or a.get("purpose") or "", "left": (r.get("left") or "") + (old if r.get("left") else ""),
        "waiting": r.get("waiting-on") or "", "vault": r.get("vault") or "", "final": a.get("last_said") or "",
        "action": a.get("action") or "", "resume": a.get("resume") or "",
    }


def by_project(cards, past):
    # Projects with live agents first, the busiest on top; no project last.
    names = {c["project"] for c in cards} | {c["project"] for c in past}
    live = lambda n: [c for c in cards if c["project"] == n and c["class"] != "closed"]
    order = sorted(names, key=lambda n: (n == "", not live(n), -len(live(n)), n))
    rank = lambda c: (c["role"] != "orchestrator", c["class"] == "closed", c["label"].lower())
    return [(n, sorted((c for c in cards if c["project"] == n), key=rank),
             sorted((c for c in past if c["project"] == n), key=lambda c: -c["at"])) for n in order]


def card_lines(c):
    lines = [("For", c["doing"]), ("Left", c["left"]), ("Waiting on", c["waiting"]), ("Vault", c["vault"]),
             ("Last said", c["final"]), ("Sweep", c["action"]), ("Resume", c["resume"])]
    # Whether it reached the vault matters once a session was asked or closed.
    return [(k, v) for k, v in lines if v and v.lower() not in ("none", "nothing", "-")
            and (k != "Vault" or c["class"] not in ("working", "idle"))]


def question(run):
    return f"""[Memory watchdog idle sweep, run {run}] Kewk set this up: when sessions sit idle or memory runs short, every idle Claude session is asked whether it is done, and the done ones are closed to free memory. Please answer now:
1. If your work is finished and worth keeping in the vault but not saved there yet, save it to the vault first.
2. Then end your reply with this block, exactly, filled in:
IDLE-REPLY: done | working | waiting
vault: saved | not needed | not saved
doing: <one line: what this session was for>
left: <one line: what is still open, or none>
waiting-on: <one line: who or what you are waiting on, or nothing>
Answer done only if nothing is left for you; the session will then be closed (it stays resumable with claude --resume)."""


def ask(agent, run):
    path = agent["transcript"]
    offset = os.path.getsize(path) if path and os.path.exists(path) else 0
    agent["asked_at"] = time.time()
    sent = subprocess.run(["omarchy-memory-message", agent["name"], question(run)],
                          capture_output=True, text=True, timeout=180)
    if sent.returncode != 0 or "sent" not in sent.stdout.lower():
        agent["outcome"] = "not reached"
        agent["note"] = (sent.stdout + sent.stderr).strip()[:200]
        return
    deadline = agent["asked_at"] + TIMEOUT
    reply = None
    while time.time() < deadline:
        time.sleep(POLL)
        if stat(agent["pid"]) is None:
            agent["outcome"] = "exited"
            return
        for e in entries(path, offset):
            for t in texts(e, "assistant"):
                reply = parse_reply(t) or reply
        # Answered and back to idle: any vault saving it did is over.
        if reply and session_file(agent["pid"]).get("status") == "idle":
            break
    agent["reply"] = reply
    if not reply:
        agent["outcome"] = "no answer"


def close(agent):
    pid, s = agent["pid"], stat(agent["pid"])
    # The same process that was asked, not a new one on a reused pid.
    if not s or s["start"] != str(session_file(pid).get("procStart", s["start"])) or s["start"] != agent["start"]:
        return "gone already"
    shell = stat(s["ppid"])
    term = stat(shell["ppid"]) if shell else None
    os.kill(pid, signal.SIGTERM)
    for _ in range(30):
        if stat(pid) is None:
            break
        time.sleep(0.5)
    else:
        return "still running after SIGTERM"
    window = "terminal left open"
    if shell and shell["comm"] in TERMINALS:
        window = "terminal closed with it"
    elif shell and term and shell["comm"] in SHELLS and term["comm"] in TERMINALS:
        active = focused_pid()
        others = subprocess.run(["pgrep", "-P", str(s["ppid"])], capture_output=True, text=True).stdout.split()
        if active == shell["ppid"]:
            window = "terminal left open: it is the window in focus"
        elif others:
            window = "terminal left open: its shell runs something else"
        else:
            os.kill(s["ppid"], signal.SIGHUP)
            window = "terminal closed"
    return f"closed, {window}"


def html_report(run, cards, past):
    esc = lambda s: (str(s or "")).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

    def block(c):
        meta = " \u00b7 ".join(x for x in (c["role"], c["name"] if c["name"] != c["label"] else "", c["kind"] if c["kind"] != "claude" else "",
                                           f"{c['mb']}M" if c.get("mb") else "", f"idle {c['idle']}" if c.get("idle") else "") if x)
        body = ""
        for k, v in card_lines(c):
            if k == "Last said" and (len(v) > 260 or "\n" in v):
                v = f"<details><summary>{esc(clip(v, 240))}</summary><div class='said'>{esc(v)}</div></details>"
            elif k == "Resume":
                v = f"<code>{esc(v)}</code>"
            else:
                v = esc(v)
            body += f"<dt>{k}</dt><dd>{v}</dd>"
        return (f"<div class='agent {c['class']}'><div class='head'><span class='pill'>{esc(c['state'])}</span>"
                f"<b>{esc(c['label'])}</b><span class='dim'>{esc(meta)}</span></div>"
                f"<div class='dim cwd'>{esc(c['cwd'])}</div><dl>{body}</dl></div>")

    sections = ""
    for name, items, gone in by_project(cards, past):
        live = [c for c in items if c["class"] != "closed"]
        closed = [c for c in items if c["class"] == "closed"]
        counts = ", ".join(x for x in (f"{len(live)} running" if live else "", f"{len(closed)} closed this run" if closed else "",
                                       f"{len(gone)} closed earlier" if gone else "") if x)
        sections += (f"<section><h2>{esc(name or 'No project')}<span class='dim'>{counts}"
                     f"{', ' + str(sum(c['mb'] for c in live)) + 'M' if live else ''}</span></h2>"
                     + "".join(block(c) for c in live))
        if closed:
            sections += "<h3>Closed in this run</h3>" + "".join(block(c) for c in closed)
        if gone:
            # Board workers come and go by the dozen: folded once there are many.
            sections += (f"<details class='gone'{' open' if len(gone) <= 4 else ''}><summary>Closed or exited in the last "
                         f"{REPORT_HOURS:g} hours ({len(gone)})</summary>" + "".join(block(c) for c in gone) + "</details>")
        sections += "</section>"
    closed = [c for c in cards if c["class"] == "closed"]
    asked = [c for c in cards if c["class"] in ("closed", "kept")]
    top = (f"Asked {len(asked)}, closed {len(closed)}, freed about {sum(c['mb'] for c in closed)}M. "
           f"{len(cards) - len(closed)} agents still running in {len({c['project'] for c in cards if c['class'] != 'closed'})} projects.")
    return f"""<!doctype html><html><head><meta charset="utf-8"><title>Idle sweep {run}</title>
<style>body{{background:#0d1117;color:#e6edf3;font:14px/1.45 system-ui;margin:24px auto;max-width:1100px;padding:0 16px}}
h1{{margin-bottom:4px}}h2{{margin:0 0 10px;font-size:20px}}h3{{margin:16px 0 8px 22px;font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:#8b949e}}
section{{border:1px solid #30363d;border-radius:10px;padding:16px;margin:18px 0;background:#11161d}}
.dim{{color:#8b949e;font-weight:400;font-size:12px;margin-left:10px}}.cwd{{margin:2px 0 0}}
.agent{{margin:8px 0 8px 22px;padding:10px 12px;border-left:3px solid #8b949e;background:#161b22;border-radius:0 8px 8px 0}}
.pill{{display:inline-block;padding:1px 9px;border-radius:10px;font-size:12px;margin-right:10px;background:#30363d}}
.working{{border-color:#58a6ff}}.working .pill{{background:#12305a;color:#79c0ff}}
.idle{{border-color:#8b949e}}.kept{{border-color:#d29922}}.kept .pill{{background:#4d3800;color:#e3b341}}
.closed{{border-color:#3fb950}}.closed .pill{{background:#0f3d1c;color:#56d364}}
.past{{border-color:#3fb950;opacity:.85}}.past .pill{{background:#0f3d1c;color:#56d364}}
dl{{display:grid;grid-template-columns:90px 1fr;gap:3px 10px;margin:8px 0 0}}dt{{color:#8b949e}}dd{{margin:0;overflow-wrap:anywhere}}
details summary{{cursor:pointer}}.said{{white-space:pre-wrap;margin-top:6px;padding:8px 10px;background:#0d1117;border-radius:6px}}
.gone>summary{{margin:16px 0 8px 22px;font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:#8b949e}}code{{color:#79c0ff;font-size:12px}}</style></head>
<body><h1>Idle session sweep</h1><p class="dim" style="margin-left:0">{clock(time.time())}, run {run}</p><p>{top}</p>{sections}</body></html>"""


def md_report(run, cards, past):
    out = [f"# Idle session sweep {run}", ""]

    def block(c):
        meta = ", ".join(x for x in (c["role"], c["name"] if c["name"] != c["label"] else "", f"{c['mb']}M" if c.get("mb") else "",
                                     f"idle {c['idle']}" if c.get("idle") else "", c["cwd"]) if x)
        lines = [f"  - **{c['label']}** [{c['state']}] {meta}"]
        for k, v in card_lines(c):
            lines.append(f"    - {k}: " + (f"`{v}`" if k == "Resume" else clip(v, 600)))
        return lines

    for name, items, gone in by_project(cards, past):
        out.append(f"- **{name or 'No project'}**")
        for c in items:
            out += block(c)
        if gone:
            out.append(f"  - Closed or exited in the last {REPORT_HOURS:g} hours:")
            for c in gone[:10]:
                out += ["  " + line for line in block(c)]
            if len(gone) > 10:
                out.append(f"    - and {len(gone) - 10} more, in the HTML report")
        out.append("")
    return "\n".join(out) + "\n"


def main():
    os.makedirs(IDLE_DIR, exist_ok=True)
    os.makedirs(os.path.join(STATE, "reports"), exist_ok=True)
    run = datetime.now().strftime("%Y%m%d-%H%M%S")
    found = json.loads(subprocess.run(["omarchy-memory-agents", "--json"], capture_output=True,
                                      text=True, check=True).stdout)
    mine, frozen, answers, now = ancestors(), frozen_pids(), load_answers(), time.time()
    focused = focused_pid()
    rows, targets = [], []
    for a in found:
        if a["pid"] in mine:
            continue
        s = stat(a["pid"])
        env = proc_env(a["pid"])
        a.update(start=s["start"] if s else "", group="not asked", project=project_of(a["cwd"], env),
                 role=env.get("OMARCHY_AGENT_ROLE", ""), key=f"{a['pid']}:{s['start'] if s else ''}")
        a["label"] = env.get("OMARCHY_AGENT_NAME") or a.get("name") or os.path.basename(a["cwd"] or "") or a["id"]
        rows.append(a)
        if a["kind"] != "claude" or a["route"] != "claude-peer":
            # Not reachable with a question: listed with what its transcript says.
            a["transcript"] = a.get("transcript") or find_transcript(a, started_at(a["start"]))
            a["purpose"], a["last_said"] = summary(a["transcript"])
            if a["kind"] == "claude" and a["transcript"]:
                a["session_id"] = os.path.basename(a["transcript"])[:-6]
            quiet = now - os.path.getmtime(a["transcript"]) if a["transcript"] else 0
            a["outcome"] = f"running, quiet {ago(quiet)}" if quiet > 120 else "running"
            if not a["purpose"]:
                first = (a.get("groups") or [{}])[0]
                a["purpose"] = clip(first.get("cmd") or first.get("leader") or a["kind"], 300)
            continue
        sid = session_file(a["pid"]).get("sessionId")
        a["session_id"] = sid
        a["purpose"], a["last_said"] = summary(a["transcript"])
        prior = answers.get(sid or "")
        a["prior"] = prior
        if a["total_mb"] < MIN_MB or (ONLY and a["name"] != ONLY):
            a["outcome"] = "working" if a["status"] != "idle" or not a["idle_s"] else f"idle {ago(a['idle_s'])}"
        elif a["pid"] in frozen:
            a["outcome"] = "paused by the brake"
        elif under(a["pid"], focused):
            # Kewk may be reading it; the question would land in his prompt.
            a["outcome"] = "in the window in focus"
        elif a["status"] != "idle" or not a["idle_s"]:
            a["outcome"] = "working"
        elif a["idle_s"] < (limit := (min(IDLE_MIN, BIG_MIN) if a["total_mb"] >= BIG_MB else IDLE_MIN) * 60):
            a["outcome"] = f"idle {ago(a['idle_s'])}, under {ago(limit)}"
        elif prior and now - prior["at"] < REASK and prior["verdict"] in ("working", "waiting", "no answer"):
            a["outcome"] = f"answered {prior['verdict']} {ago(now - prior['at'])} ago"
        else:
            targets.append(a)

    if CHECK:
        sys.exit(0 if targets else 1)
    (print if DRY else log)(f"run {run}: {'report only, would ask' if REPORT else 'asking'} {len(targets)} of {len(rows)} Claude sessions"
        f" ({', '.join(a['name'] for a in targets) or 'none'})")
    if DRY:
        for a in rows:
            if a["route"] != "claude-peer":
                continue
            print(f"{'ask' if a in targets else 'skip':<5}{a['name']:<20}{a['total_mb']:>6}M  idle {ago(a['idle_s']):<5} {a.get('outcome', '')}")
        return

    if REPORT:
        for a in targets:
            a["outcome"] = f"idle {ago(a['idle_s'])}, due to be asked"
        targets = []
    threads = [threading.Thread(target=ask, args=(a, run)) for a in targets]
    for t in threads:
        t.start()
    for t in threads:
        t.join()

    for a in targets:
        r = a.get("reply")
        a["prior"] = None
        if r:
            answers[a["session_id"] or a["name"]] = {**r, "at": time.time(), "name": a["name"]}
        elif a.get("outcome") == "no answer":
            # Asked again only after REASK, or every sweep would retype the question.
            answers[a["session_id"] or a["name"]] = {"verdict": "no answer", "at": time.time(), "name": a["name"]}
        closable = r and r["verdict"] == "done" and r.get("vault", "").lower().startswith(("saved", "not needed"))
        if closable or (CLOSE_SILENT and a.get("outcome") == "no answer"):
            a["action"] = close(a)
            if a["action"].startswith("closed"):
                a["group"] = "closed"
                a["resume"] = f"cd {a['cwd']} && claude --resume {a['session_id']}"
                answers.pop(a["session_id"] or a["name"], None)
            else:
                a["group"] = "left running"
        else:
            a["group"] = "left running"
            a["action"] = ("done, but its work is not in the vault yet" if r and r["verdict"] == "done"
                           else a.get("outcome") or f"kept: {r['verdict']}")
        log(f"run {run}: {a['name']} {a['total_mb']}M answered "
            f"{(r or {}).get('verdict') or a.get('outcome')}: {a['action']}")
    save_answers(answers)

    # Sessions closed here, and ones seen by the last run that have since gone
    # on their own, are kept so later reports still say what they finished.
    cards = [card(a) for a in rows]
    ledger = [c for c in load_closed() if now - c.get("at", 0) < 7 * 86400]
    known = {c["key"] for c in ledger} | {c["key"] for c in cards}
    for key, c in load_seen().items():
        pid, _, start = key.partition(":")
        # Not listed is not gone: the session running this report skips itself.
        if key not in known and (stat(pid) or {}).get("start") != start:
            at = os.path.getmtime(c["transcript"]) if c.get("transcript") and os.path.exists(c["transcript"]) else now
            c["purpose_now"], c["final"] = summary(c.get("transcript"))
            c.update(at=at, state=f"exited by {clock(at)}", action="exited on its own, not closed by the sweep")
            c["doing"] = c.get("doing") or c.pop("purpose_now")
            c.pop("purpose_now", None)
            if c["kind"] == "claude" and c.get("session_id"):
                c["resume"] = f"cd {c['cwd']} && claude --resume {c['session_id']}"
            c["class"] = "past"
            ledger.append(c)
    past = [c for c in ledger if now - c["at"] < REPORT_HOURS * 3600]
    for c in cards:
        if c["class"] == "closed":
            ledger.append({**c, "at": time.time(), "class": "past"})
    tmp = CLOSED + ".tmp"
    with open(tmp, "w") as f:
        f.writelines(json.dumps(c) + "\n" for c in ledger)
    os.replace(tmp, CLOSED)
    sessions = {a["key"]: a for a in rows}
    seen = {c["key"]: {**c, "transcript": sessions[c["key"]].get("transcript"),
                       "session_id": sessions[c["key"]].get("session_id")} for c in cards if c["class"] != "closed"}
    tmp = SEEN + ".tmp"
    with open(tmp, "w") as f:
        json.dump(seen, f)
    os.replace(tmp, SEEN)

    base = os.path.join(STATE, "reports", f"idle-{run}")
    with open(base + ".md", "w") as f:
        f.write(md_report(run, cards, past))
    with open(base + ".html", "w") as f:
        f.write(html_report(run, cards, past))
    shutil.copyfile(base + ".html", os.path.join(STATE, "reports", "idle-latest.html"))
    closed = [a for a in rows if a["group"] == "closed"]
    left = [a for a in rows if a["group"] != "closed"]
    headline = (f"Closed {len(closed)} ({sum(a['total_mb'] for a in closed)}M): "
               f"{', '.join(a['name'] for a in closed) or 'none'}. {len(left)} left running.")
    log(f"run {run}: {headline} Report: {base}.html")
    print(base + ".html")
    if targets and shutil.which("omarchy-notification-send"):
        subprocess.run(["omarchy-notification-send", "--glyph", MEMORY_GLYPH, "Idle Claude sessions swept",
                        headline + " Click for the report.", "--exec", "xdg-open", base + ".html"],
                       capture_output=True)


if __name__ == "__main__":
    main()
