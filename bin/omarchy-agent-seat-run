#!/bin/bash

# omarchy:summary=Launch a sandboxed app on the agent seat and print its agent window number
# omarchy:args=[--no-wait] [--gpu] <command> [args...]
# omarchy:examples=omarchy agent seat run chromium https://omarchy.org | omarchy agent seat run foot | omarchy agent seat run --gpu vkcube

# The app runs in a bubblewrap sandbox whose only way to the desktop is the
# agent seat broker. It gets no Hyprland IPC, no user Wayland or X11 socket, no
# D-Bus (so no keyring and no portals), no /dev/uinput, no GPU and its own
# home, so it can neither drive nor read the user's seat.
#
# --gpu asks the user first, in their own menu, to let this launch use the GPU
# (once, or for the rest of the session). Only then does the app get the GPU
# devices, and a broker socket of its own that also offers GPU buffers.

wait_for_window=true
gpu=false
while [[ $1 == --* ]]; do
  case $1 in
    --no-wait) wait_for_window=false ;;
    --gpu) gpu=true ;;
    *)
      echo "Unknown option $1" >&2
      exit 1
      ;;
  esac
  shift
done

if (($# == 0)); then
  echo "Usage: omarchy agent seat run [--no-wait] [--gpu] <command> [args...]" >&2
  exit 1
fi

runtime="$XDG_RUNTIME_DIR/omarchy/agent-seat"
agent_home="$HOME/.local/share/omarchy/agent-seat/home"

windows() {
  omarchy-agent-seat-broker call '{"command":"windows"}' 2>/dev/null | jq -r '.windows[].window'
}

if ! omarchy-agent-seat-broker call '{"command":"windows"}' >/dev/null 2>&1; then
  mkdir -p "$runtime"
  setsid -f omarchy-agent-seat-broker serve >>"$runtime/broker.log" 2>&1
  for _ in {1..50}; do
    [[ -S $runtime/control ]] && break
    sleep 0.1
  done
fi

display="$runtime/wayland-0"
if [[ $gpu == "true" ]]; then
  # Waits for the user's answer; the broker prints why when they decline.
  grant=$(omarchy-agent-seat-broker call "$(jq -cn --arg app "$(basename "$1")" '{command: "gpu", args: {app: $app}}')") || exit 1
  display=$(jq -r '.socket' <<<"$grant")
fi

mkdir -p "$agent_home"
before=$(windows)

sandbox=(
  --unshare-all --share-net --new-session
  --ro-bind /usr /usr --symlink usr/bin /bin --symlink usr/bin /sbin --symlink usr/lib /lib --symlink usr/lib /lib64
  --ro-bind /etc /etc --ro-bind /sys /sys --ro-bind-try /run/systemd/resolve /run/systemd/resolve
  --proc /proc --dev /dev --tmpfs /dev/shm --tmpfs /tmp
  --bind "$agent_home" "$HOME"
  --ro-bind-try "$HOME/.local/share/fonts" "$HOME/.local/share/fonts"
  --ro-bind-try "$HOME/.local/share/icons" "$HOME/.local/share/icons"
  --ro-bind-try "$HOME/.config/fontconfig" "$HOME/.config/fontconfig"
  --dir "$XDG_RUNTIME_DIR" --chmod 0700 "$XDG_RUNTIME_DIR"
  --bind "$display" "$XDG_RUNTIME_DIR/wayland-0"
  --chdir "$HOME" --clearenv
  --setenv PATH /usr/local/bin:/usr/bin --setenv HOME "$HOME" --setenv USER "$USER" --setenv LANG "${LANG:-C.UTF-8}"
  --setenv XDG_RUNTIME_DIR "$XDG_RUNTIME_DIR" --setenv WAYLAND_DISPLAY wayland-0 --setenv XDG_SESSION_TYPE wayland
  --setenv GDK_BACKEND wayland --setenv QT_QPA_PLATFORM wayland --setenv ELECTRON_OZONE_PLATFORM_HINT wayland
)

if [[ $gpu == "true" ]]; then
  for device in /dev/dri /dev/nvidia*; do
    [[ -e $device ]] && sandbox+=(--dev-bind "$device" "$device")
  done
fi

# Apps installed outside /usr (an AppImage-style bundle under ~/.local/opt)
# get their own directory mounted read-only.
executable=$(realpath -e "$(type -P "$1")" 2>/dev/null)
if [[ -n $executable && $executable != /usr/* ]]; then
  sandbox+=(--ro-bind "$(dirname "$executable")" "$(dirname "$executable")")
  set -- "$executable" "${@:2}"
fi

setsid -f bwrap "${sandbox[@]}" -- "$@" >>"$runtime/apps.log" 2>&1

if [[ $wait_for_window == "true" ]]; then
  for _ in {1..150}; do
    window=$(comm -13 <(sort <<<"$before") <(windows | sort) | head -1)
    if [[ -n $window ]]; then
      echo "$window"
      exit 0
    fi
    sleep 0.1
  done

  echo "No agent window appeared within 15 seconds (see $runtime/apps.log)" >&2
  exit 1
fi
