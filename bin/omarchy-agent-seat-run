#!/bin/bash

# omarchy:summary=Launch a sandboxed app on the agent seat and print its agent window number
# omarchy:args=[--no-wait] [--gpu] [--cdp] [--share <path>] [--share-ro <path>] <command> [args...]
# omarchy:examples=omarchy agent seat run chromium https://omarchy.org | omarchy agent seat run foot | omarchy agent seat run --gpu vkcube | omarchy agent seat run --share ~/Projects/site chromium ~/Projects/site/index.html

# The app runs in a bubblewrap sandbox whose only way to the desktop is the
# agent seat broker. It gets no Hyprland IPC, no user Wayland or X11 socket, no
# user D-Bus (only a private bus of its own, so no keyring and no portals), no
# /dev/uinput, no GPU and its own home, so it can neither drive nor read the
# user's seat. That home is one directory shared by every app on the seat and
# kept across stop, so logins and cookies made in it persist.
#
# It does share the host's network: besides the internet it reaches every
# service listening on the host's localhost (databases, dev servers, browser
# debugging ports), and a port it opens is reachable from the whole machine.
#
# --gpu asks the user first, in their own menu, to let this launch use the GPU
# (once, or for the rest of the session). Only then does the app get the GPU
# devices, and a broker socket of its own that also offers GPU buffers.
#
# --cdp starts a Chromium or Electron app with its DevTools protocol on a free
# localhost port, which omarchy agent seat ui reads its page through.
#
# --share and --share-ro hand the app one of the user's files or directories,
# read-write or read-only, at the same path. The seat asks nothing of its own
# here: sharing is part of the command, so the agent's own permission rules
# decide it, like any file the agent touches itself. Shares that would undo
# the sandbox are refused: the root, the user's home or /tmp as a whole, the
# X11 sockets, $XDG_RUNTIME_DIR and /run/user (Hyprland, D-Bus, the keyring),
# /proc and /dev, any directory holding one of those, and anything inside
# ~/.config, ~/.ssh, ~/.gnupg or ~/.local/share/keyrings, or wherever one of
# those links to. Only a directory or a regular file can be shared, and the
# sandbox mounts the very one that was checked, by an open descriptor, never a
# path that could be swapped in the meantime.

home=$(realpath -m -- "$HOME")
runtime_dir=$(realpath -m -- "$XDG_RUNTIME_DIR")
# Refused when a path is one of these or holds one.
broad=("$home" /tmp)
# Refused when a path is one of these, lies inside one, or holds one.
private=("$home/.config" "$home/.ssh" "$home/.gnupg" "$home/.local/share/keyrings" "$runtime_dir" /run/user /tmp/.X11-unix /proc /dev)

# Shares are compared resolved, so a root that is a link (~/.ssh pointing into
# ~/vault, say) is refused at its target as well as at its own path.
for root in "${broad[@]}"; do
  broad+=("$(realpath -m -- "$root")")
done
for root in "${private[@]}"; do
  private+=("$(realpath -m -- "$root")")
done

# Prints what a resolved path would expose to an agent app, if anything.
exposes() {
  local path=$1 root

  if [[ $path == "/" ]]; then
    echo "/"
    return 0
  fi
  for root in "${broad[@]}"; do
    if [[ $root == "$path" || $root == "$path"/* ]]; then
      echo "$root"
      return 0
    fi
  done
  for root in "${private[@]}"; do
    if [[ $path == "$root" || $path == "$root"/* || $root == "$path"/* ]]; then
      echo "$root"
      return 0
    fi
  done
  return 1
}

# A directory that is plainly one app's own install: its libraries or
# resources sit beside the executable. A bin directory never counts.
app_bundle() {
  local directory=$1

  [[ ${directory##*/} == "bin" || ${directory##*/} == "sbin" ]] && return 1
  [[ -d $directory/lib || -d $directory/resources || -e $directory/resources.pak || -e $directory/AppRun ]]
}

# Opens a checked directory or file and sets pinned_fd to it, so the sandbox
# mounts what was checked even if the path is swapped (for a link into ~/.ssh,
# say, by an app with a writable share above it) before bwrap runs. A
# directory is opened through its "." so a swapped-in FIFO cannot block the
# launch. Fails unless the open file is still the checked path and of its kind.
pinned=()
pin() {
  local path=$1 fd kind

  if [[ -d $path ]]; then
    kind="directory"
    { exec {fd}<"$path/."; } 2>/dev/null || return 1
  elif [[ -f $path ]]; then
    kind="file"
    { exec {fd}<"$path"; } 2>/dev/null || return 1
  else
    return 1
  fi
  pinned+=("$fd")
  [[ $(readlink "/proc/self/fd/$fd") == "$path" ]] || return 1
  if [[ $kind == "directory" ]]; then
    [[ -d /proc/self/fd/$fd ]] || return 1
  else
    [[ -f /proc/self/fd/$fd ]] || return 1
  fi
  pinned_fd=$fd
}

# Closes every pinned file.
unpin() {
  local fd

  for fd in "${pinned[@]}"; do
    exec {fd}<&-
  done
  pinned=()
}

wait_for_window=true
gpu=false
cdp=false
shares=()
while [[ $1 == --* ]]; do
  case $1 in
    --no-wait) wait_for_window=false ;;
    --gpu) gpu=true ;;
    --cdp) cdp=true ;;
    --share | --share-ro)
      if ! path=$(realpath -e -- "${2:-}" 2>/dev/null); then
        echo "Nothing to share at ${2:-(no path given)}" >&2
        exit 1
      fi
      if exposed=$(exposes "$path"); then
        echo "Refusing to share $path with an agent app: it would expose $exposed" >&2
        exit 1
      fi
      if [[ ! -d $path && ! -f $path ]]; then
        echo "Refusing to share $path with an agent app: only a directory or a regular file can be shared" >&2
        exit 1
      fi
      if ! pin "$path"; then
        echo "Refusing to share $path with an agent app: it changed or could not be opened once checked" >&2
        exit 1
      fi
      if [[ $1 == "--share" ]]; then
        shares+=(--bind-fd "$pinned_fd" "$path")
      else
        shares+=(--ro-bind-fd "$pinned_fd" "$path")
      fi
      shift
      ;;
    *)
      echo "Unknown option $1" >&2
      exit 1
      ;;
  esac
  shift
done

if (($# == 0)); then
  echo "Usage: omarchy agent seat run [--no-wait] [--gpu] [--cdp] [--share <path>] [--share-ro <path>] <command> [args...]" >&2
  exit 1
fi

# An app installed outside /usr gets its executable read-only. Its directory
# comes along only when it is an app bundle (under ~/.local/opt, say) that
# exposes nothing, so running a program from $HOME or /tmp never hands the app
# the rest of that directory.
program=()
executable=$(realpath -e -- "$(type -P -- "$1")" 2>/dev/null)
if [[ -n $executable && $executable != /usr/* ]]; then
  bundle=$(dirname -- "$executable")
  if exposed=$(exposes "$executable"); then
    echo "Refusing to run $executable on the agent seat: it would expose $exposed" >&2
    exit 1
  elif app_bundle "$bundle" && ! exposes "$bundle" >/dev/null; then
    if ! pin "$bundle"; then
      echo "Refusing to run $executable on the agent seat: its directory changed or could not be opened once checked" >&2
      exit 1
    fi
    program=(--ro-bind-fd "$pinned_fd" "$bundle")
  else
    if ! pin "$executable"; then
      echo "Refusing to run $executable on the agent seat: it changed or could not be opened once checked" >&2
      exit 1
    fi
    program=(--ro-bind-fd "$pinned_fd" "$executable")
  fi
  set -- "$executable" "${@:2}"
fi

runtime="$XDG_RUNTIME_DIR/omarchy/agent-seat"
agent_home="$HOME/.local/share/omarchy/agent-seat/home"
sandbox_supervisor=$(realpath -e "$OMARCHY_PATH/bin/omarchy-agent-seat-sandbox")

# Each seat window with the pid of the app that opened it, as the broker sees
# it: the host pid of the process inside the sandbox.
windows() {
  omarchy-agent-seat-broker call '{"command":"state"}' 2>/dev/null | jq -r '.windows[] | "\(.window) \(.pid // 0)"'
}

# Whether a process runs in this launch's sandbox: the supervisor is among its
# ancestors. bwrap's PID-namespace init stays a child of the outer bwrap, which
# is the supervisor's child, and a sandboxed process that loses its parent is
# reparented to that init, so every chain from inside ends at the supervisor.
# The chain holds for apps that nest their own PID namespaces (Chromium's
# sandbox) too, where comparing namespaces would not.
in_sandbox() {
  local pid=$1 status

  while ((pid > 1)); do
    ((pid == sandbox_pid)) && return 0
    { status=$(<"/proc/$pid/status"); } 2>/dev/null || return 1
    [[ $status =~ $'\n'PPid:[[:space:]]+([0-9]+) ]] || return 1
    pid=${BASH_REMATCH[1]}
  done
  return 1
}

mkdir -p "$runtime/sandboxes"

# The new window is one missing from the list taken before the launch whose
# app runs in this launch's sandbox, so another app's window that opens
# meanwhile (a dialog, say) is never handed back. Launches still take turns
# from that list until their window appears (or the wait times out). A
# --no-wait launch takes its turn too, but its window may still appear while a
# later launch waits. Stop never takes this lock.
exec 8>"$runtime/launch.lock"
flock 8

# Serialize seat startup and shutdown so stop cannot miss a sandbox whose
# supervisor is still being registered.
exec 9>"$runtime/sandboxes.lock"
flock 9

broker_answers() {
  omarchy-agent-seat-broker call '{"command":"windows"}' >/dev/null 2>&1
}

# A broker that died leaves its sockets behind, so the seat is ready only once
# a broker answers. A new broker replaces both sockets before it answers on
# control, so the wayland-0 bound below is then its own, never a dead one.
if ! broker_answers; then
  # The broker outlives this launch, so it gets none of the pinned files.
  (
    unpin
    setsid -f omarchy-agent-seat-broker serve >>"$runtime/broker.log" 2>&1 8>&- 9>&-
  )
  deadline=$((SECONDS + 10))
  until broker_answers; do
    if ((SECONDS >= deadline)); then
      echo "The agent seat broker did not start within 10 seconds (see $runtime/broker.log)" >&2
      exit 1
    fi
    sleep 0.1
  done
fi

display="$runtime/wayland-0"
if [[ $gpu == "true" ]]; then
  # Waits for the user's answer; the broker prints why when they decline.
  grant=$(omarchy-agent-seat-broker call "$(jq -cn --arg app "$(basename "$1")" '{command: "gpu", args: {app: $app}}')") || exit 1
  display=$(jq -r '.socket' <<<"$grant")
fi

mkdir -p "$agent_home"
before=$(windows)

sandbox=(
  --unshare-all --share-net --new-session
  --ro-bind /usr /usr --symlink usr/bin /bin --symlink usr/bin /sbin --symlink usr/lib /lib --symlink usr/lib /lib64
  --ro-bind /etc /etc --ro-bind /sys /sys --ro-bind-try /run/systemd/resolve /run/systemd/resolve
  --proc /proc --dev /dev --tmpfs /dev/shm --tmpfs /tmp
  --bind "$agent_home" "$HOME"
  --ro-bind-try "$HOME/.local/share/fonts" "$HOME/.local/share/fonts"
  --ro-bind-try "$HOME/.local/share/icons" "$HOME/.local/share/icons"
  --ro-bind-try "$HOME/.config/fontconfig" "$HOME/.config/fontconfig"
  --dir "$XDG_RUNTIME_DIR" --chmod 0700 "$XDG_RUNTIME_DIR"
  --bind "$display" "$XDG_RUNTIME_DIR/wayland-0"
  --chdir "$HOME" --clearenv
  --setenv PATH /usr/local/bin:/usr/bin --setenv HOME "$HOME" --setenv USER "$USER" --setenv LANG "${LANG:-C.UTF-8}"
  --setenv XDG_RUNTIME_DIR "$XDG_RUNTIME_DIR" --setenv WAYLAND_DISPLAY wayland-0 --setenv XDG_SESSION_TYPE wayland
  --setenv GDK_BACKEND wayland --setenv QT_QPA_PLATFORM wayland --setenv ELECTRON_OZONE_PLATFORM_HINT wayland
)

if [[ $gpu == "true" ]]; then
  for device in /dev/dri /dev/nvidia*; do
    [[ -e $device ]] && sandbox+=(--dev-bind "$device" "$device")
  done
fi

sandbox+=("${program[@]}")

# Last, so a share's own mode wins over the mounts above. Nothing a share can
# name reaches the sandbox's own runtime directory or /tmp as a whole.
sandbox+=("${shares[@]}")

record=$(mktemp "$runtime/sandboxes/sandbox.XXXXXX")
marker=${record##*.}

# A private session bus, reachable only from this sandbox and the seat's own
# commands, carries the app's accessibility tree (omarchy agent seat ui).
session="$runtime/sandboxes/$marker.d"
mkdir -p -m 0700 "$session" "$session/bus"
bus="unix:path=$XDG_RUNTIME_DIR/agent-bus/bus"
sandbox+=(
  --bind "$session/bus" "$XDG_RUNTIME_DIR/agent-bus"
  --ro-bind "$(realpath -e "$OMARCHY_PATH/bin/omarchy-agent-seat-init")" /run/omarchy-agent-seat-init
  --setenv DBUS_SESSION_BUS_ADDRESS "$bus" --setenv AT_SPI_BUS_ADDRESS "$bus"
  --setenv GTK_A11Y atspi --setenv NO_AT_BRIDGE 0 --setenv QT_LINUX_ACCESSIBILITY_ALWAYS_ON 1
)
set -- /run/omarchy-agent-seat-init "$@"
if [[ $cdp == "true" ]]; then
  port=$(python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')
  echo "$port" >"$session/cdp-port"
  set -- "$@" "--remote-debugging-port=$port"
fi
# The supervisor passes the pinned files on to bwrap, which mounts them and
# closes them before the app starts; this launch needs them no longer.
setsid "$sandbox_supervisor" "$record" "$marker" "${sandbox[@]}" -- "$@" >>"$runtime/apps.log" 2>&1 8>&- 9>&- &
supervisor_pid=$!
unpin
for _ in {1..50}; do
  read -r tracked_supervisor _ _ tracked_bwrap _ <"$record" || true
  (( ${tracked_bwrap:-0} != 0 )) && break
  kill -0 "$supervisor_pid" 2>/dev/null || break
  sleep 0.01
done
flock -u 9
exec 9>&-

# The supervisor writes its own pid to the record; $! is the same process
# unless setsid had to fork.
sandbox_pid=${tracked_supervisor:-$supervisor_pid}
[[ $sandbox_pid =~ ^[0-9]+$ ]] || sandbox_pid=$supervisor_pid

if [[ $wait_for_window == "true" ]]; then
  for _ in {1..150}; do
    while read -r window pid; do
      if in_sandbox "$pid"; then
        echo "$window"
        exit 0
      fi
    done < <(comm -13 <(sort <<<"$before") <(windows | sort) | sort -n)
    sleep 0.1
  done

  echo "No agent window appeared within 15 seconds (see $runtime/apps.log)" >&2
  exit 1
fi
