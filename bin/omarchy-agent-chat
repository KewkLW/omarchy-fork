#!/bin/bash

# omarchy:summary=Run the agent room pane: the whole conversation live, and a prompt to join it
# omarchy:hidden=true

echo "Agent room. Everything agents say to each other and to you shows up here."
echo "Type to speak to every agent, or @<agent> <message> to speak to one."
echo "/agents lists who's here, /pause stops agents messaging anyone, /resume lets"
echo "them carry on."
echo
omarchy-agent-list
echo

omarchy-agent-room-core log --follow &
follower=$!
trap 'kill $follower 2>/dev/null' EXIT

while IFS= read -e -r line; do
  history -s "$line"

  case $line in
  "") continue ;;
  /agents) omarchy-agent-list; continue ;;
  /pause | /resume) omarchy-agent-room-core "${line#/}"; continue ;;
  esac

  # A room speaks to everyone in it unless you single someone out.
  if [[ $line =~ ^@([^[:space:]]+)[[:space:]]+(.+)$ ]]; then
    omarchy-agent-send "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" >/dev/null
  else
    omarchy-agent-send all "$line" >/dev/null
  fi
done
