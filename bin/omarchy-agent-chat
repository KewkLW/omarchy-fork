#!/bin/bash

# omarchy:summary=Run the agent room pane: the live conversation and a prompt to join it
# omarchy:hidden=true

echo "Agent room. @<agent> <message> to one agent, @all <message> to every agent,"
echo "or just a message for whichever agent spoke last. /agents lists who's here."
echo
omarchy-agent-list
echo

omarchy-agent-room-core log --follow &
follower=$!
trap 'kill $follower 2>/dev/null' EXIT

last_speaker() {
  omarchy-agent-room-core log --json | jq -r 'select(.from != "user") | .from' | tail -n1
}

while IFS= read -e -r line; do
  history -s "$line"

  if [[ -z $line ]]; then
    continue
  elif [[ $line == "/agents" ]]; then
    omarchy-agent-list
    continue
  elif [[ $line =~ ^@([^[:space:]]+)[[:space:]]+(.+)$ ]]; then
    target=${BASH_REMATCH[1]}
    text=${BASH_REMATCH[2]}
  else
    target=$(last_speaker)
    text=$line
  fi

  if [[ -z $target ]]; then
    echo "No agent has spoken yet, so address one: @<agent> <message>"
  else
    omarchy-agent-send "$target" "$text" >/dev/null
  fi
done
