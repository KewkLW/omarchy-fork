#!/bin/bash

# omarchy:summary=Show whether the agent seat is running and who controls it
# omarchy:args=[--json]

if ! status=$(omarchy-agent-seat-broker call '{"command":"status"}' 2>/dev/null); then
  status='{"running": false}'
else
  status=$(jq '. + {running: true}' <<<"$status")
fi

if [[ $1 == "--json" ]]; then
  echo "$status"
elif [[ $(jq -r '.running' <<<"$status") == "true" ]]; then
  jq -r '"Agent seat: running\n  control:  \(.control)\n  apps:     \(.apps)\n  windows:  \(.windows)"' <<<"$status"
else
  echo "Agent seat: stopped"
fi
