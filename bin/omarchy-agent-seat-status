#!/bin/bash

# omarchy:summary=Show whether the agent seat is running and what is on it
# omarchy:args=[--all] [--json]

# Exits non-zero when the seat is stopped, so it can guard menu entries. It
# reports the calling agent's lane; --all reports every lane, running when any
# one is, with the apps and windows of all of them.

if [[ $1 == "--all" ]]; then
  shift
  status=$(
    for lane in $(omarchy-agent-seat-lane --list); do
      [[ -S $(OMARCHY_AGENT_SEAT=$lane omarchy-agent-seat-lane --runtime)/control ]] || continue  # no broker in that lane
      OMARCHY_AGENT_SEAT=$lane "$0" --json | jq --arg lane "$lane" '. + {lane: $lane}'
    done | jq -s '{running: any(.running), apps: (map(.apps // 0) | add // 0), windows: (map(.windows // 0) | add // 0), lanes: map(select(.running) | .lane)}'
  )
  if [[ $1 == "--json" ]]; then
    echo "$status"
  elif [[ $(jq -r '.running' <<<"$status") == "true" ]]; then
    jq -r '"Agent seat: running\n  lanes:    \(.lanes | join(", "))\n  apps:     \(.apps)\n  windows:  \(.windows)"' <<<"$status"
  else
    echo "Agent seat: stopped"
  fi
  [[ $(jq -r '.running' <<<"$status") == "true" ]]
  exit
fi

# The broker answers status at once. One that holds its socket open but never
# answers would hang this call, and with it the menu's guard batch, so a call
# that takes longer than two seconds counts as a stopped seat.
if ! status=$(timeout 2 omarchy-agent-seat-broker call '{"command":"status"}' 2>/dev/null); then
  status='{"running": false}'
else
  status=$(jq '. + {running: true}' <<<"$status")
fi

if [[ $1 == "--json" ]]; then
  echo "$status"
elif [[ $(jq -r '.running' <<<"$status") == "true" ]]; then
  jq -r '"Agent seat: running\n  apps:     \(.apps)\n  windows:  \(.windows)"' <<<"$status"
else
  echo "Agent seat: stopped"
fi

[[ $(jq -r '.running' <<<"$status") == "true" ]]
