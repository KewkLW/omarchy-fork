#!/usr/bin/python3

# omarchy:summary=Run an agent under a pty relay so other agents and the user can speak to it
# omarchy:args=<kind> <command> [args...]
# omarchy:hidden=true

# omarchy-agent starts agents through this relay. It passes the terminal through
# untouched and puts the agent in the agent room:
#
# - Incoming: input.sock in the agent's room directory. A message sent to the
#   agent, by another agent or by the user from the room pane, is typed into its
#   prompt, headed with who sent it and how to answer. The relay works out the
#   sender itself, from the connecting process's tree, so nothing a message says
#   can change who it appears to be from.
# - Outgoing: the agent's outbox. The agent's room commands leave requests there
#   and the relay carries them out as that agent. Agents often run their commands
#   in a sandbox that can't see other processes or open sockets; the relay runs
#   outside it, so the room works the same from any sandbox that can write to the
#   outbox.

import contextlib
import errno
import fcntl
import importlib.machinery
import importlib.util
import io
import os
import pty
import select
import shutil
import signal
import socket
import struct
import sys
import termios
import time
import tty

if len(sys.argv) < 3:
    print("Usage: omarchy-agent-pty <kind> <command> [args...]", file=sys.stderr)
    sys.exit(1)

kind, command = sys.argv[1], sys.argv[2:]

loader = importlib.machinery.SourceFileLoader("room", shutil.which("omarchy-agent-room-core"))
room = importlib.util.module_from_spec(importlib.util.spec_from_loader("room", loader))
loader.exec_module(room)

# Paste mode markers, watched for in the agent's output: a message typed into a
# prompt that understands bracketed paste arrives as one paste, so a multi-line
# message can't submit early at its first newline.
PASTE_ON, PASTE_OFF = b"\x1b[?2004h", b"\x1b[?2004l"
MAX_MESSAGE = 64 * 1024

# The agent waits for the relay to register it before it starts, so nothing it
# says in its first moments can be taken for whoever launched it.
go_read, go_write = os.pipe()
pid, master = pty.fork()
if pid == 0:
    os.close(go_write)
    os.read(go_read, 1)
    os.close(go_read)
    os.environ[room.OUTBOX_ENV] = os.path.join(room.OUTBOXES, f"{kind}-{os.getpid()}")
    try:
        os.execvp(command[0], command)
    except OSError as error:
        print(f"{command[0]}: {error.strerror}", file=sys.stderr)
    os._exit(127)

stdin = sys.stdin.fileno()
stdout = sys.stdout.fileno()
interactive = os.isatty(stdin)


def copy_size(*_):
    if interactive:
        size = fcntl.ioctl(stdin, termios.TIOCGWINSZ, b"\0" * 8)
        fcntl.ioctl(master, termios.TIOCSWINSZ, size)
        os.kill(pid, signal.SIGWINCH)


copy_size()
signal.signal(signal.SIGWINCH, copy_size)
saved = termios.tcgetattr(stdin) if interactive else None
if interactive:
    tty.setraw(stdin)

meta = None
listener = None
sock_path = None
outbox = None
try:
    os.makedirs(room.RUNTIME, mode=0o700, exist_ok=True)
    with open(room.PIDNS, "w") as f:
        f.write(room.my_pidns() or "")
    meta = room.register(kind, pid, room.read_stat(pid)["start"], relay_pid=os.getpid())
    outbox = os.path.join(room.OUTBOXES, meta["id"])
    shutil.rmtree(outbox, ignore_errors=True)
    os.makedirs(outbox, mode=0o700)
    sock_path = os.path.join(room.agent_dir(meta["id"]), "input.sock")
    try:
        os.unlink(sock_path)
    except FileNotFoundError:
        pass
    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    listener.bind(sock_path)
    os.chmod(sock_path, 0o600)
    listener.listen(4)
except (OSError, TypeError, room.RoomError):
    # The agent still runs without the room; it just isn't part of it.
    listener = None
    outbox = None

os.close(go_read)
os.write(go_write, b"x")
os.close(go_write)


def sender(conn):
    peer_pid, peer_uid, _ = struct.unpack("3i", conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
    if peer_uid != os.getuid():
        return None
    who = room.identify(peer_pid)
    # An agent talking to itself through its own relay is a loop, not a message.
    return None if who["id"] == meta["id"] else who


def heading(who):
    if who["id"] == room.USER:
        name = "The user"
    elif who.get("name"):
        name = f"{who['name']} ({who['id']})"
    else:
        name = who["id"]
    return f"[Agent room] {name} says:", f'(Answer in the room: omarchy agent send {who["id"]} "...")'


def type_message(who, text, paste):
    text = text.strip()
    if not text:
        return
    head, answer = heading(who)
    if paste:
        os.write(master, b"\x1b[200~" + f"{head}\n{text}\n{answer}".encode() + b"\x1b[201~")
    else:
        os.write(master, " ".join(f"{head} {text} {answer}".split("\n")).encode())
    # Prompts that read the paste and the Enter in one go take the Enter as part
    # of the paste, so give the paste a moment to land first.
    time.sleep(0.1)
    os.write(master, b"\r")


def accept(paste):
    conn, _ = listener.accept()
    with conn:
        conn.settimeout(2)
        who = sender(conn)
        if who is None:
            return
        data = b""
        try:
            while len(data) < MAX_MESSAGE:
                chunk = conn.recv(4096)
                if not chunk:
                    break
                data += chunk
            type_message(who, data[:MAX_MESSAGE].decode(errors="replace"), paste)
            conn.sendall(b"ok")
        except OSError:
            return


# Carries out one room command for the agent, as the agent.
def carry_out(argv):
    if not isinstance(argv, list) or not argv or argv[0] not in room.RELAYED:
        return 1, "", "The relay doesn't do that\n"
    if argv[0] == "send" and len(argv) < 3:
        return 1, "", "Nothing to send\n"
    out, err = io.StringIO(), io.StringIO()
    room.CALLER_OVERRIDE = room.load_json(os.path.join(room.agent_dir(meta["id"]), "agent.json")) or meta
    try:
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            args = room.build_parser().parse_args(argv)
            args.func(args)
        code = 0
    except room.RoomError as error:
        err.write(f"{error}\n")
        code = 1
    except SystemExit as exit:
        code = exit.code if isinstance(exit.code, int) else 1
    finally:
        room.CALLER_OVERRIDE = None
    return code, out.getvalue(), err.getvalue()


def serve_outbox():
    try:
        requests = sorted(n for n in os.listdir(outbox) if n.endswith(".req"))
    except OSError:
        return
    for name in requests:
        path = os.path.join(outbox, name)
        request = room.load_json(path)
        try:
            os.unlink(path)
        except OSError:
            continue
        code, out, err = carry_out((request or {}).get("argv"))
        room.write_json(os.path.join(outbox, f"{name[:-4]}.out"), {"code": code, "out": out, "err": err})


paste = False
tail = b""
status = 0
try:
    while True:
        watched = [master] + ([stdin] if interactive else []) + ([listener] if listener else [])
        try:
            ready, _, _ = select.select(watched, [], [], 0.1 if outbox else None)
        except InterruptedError:
            continue
        if master in ready:
            try:
                data = os.read(master, 65536)
            except OSError as error:
                if error.errno != errno.EIO:
                    raise
                data = b""
            if not data:
                break
            os.write(stdout, data)
            seen = tail + data
            on, off = seen.rfind(PASTE_ON), seen.rfind(PASTE_OFF)
            if on != off:
                paste = on > off
            tail = seen[-(len(PASTE_ON) - 1):]
        if interactive and stdin in ready:
            data = os.read(stdin, 65536)
            if not data:
                break
            os.write(master, data)
        if listener and listener in ready:
            accept(paste)
        if outbox:
            serve_outbox()
finally:
    if saved is not None:
        termios.tcsetattr(stdin, termios.TCSAFLUSH, saved)
    if sock_path:
        with contextlib.suppress(OSError):
            os.unlink(sock_path)
    if outbox:
        shutil.rmtree(outbox, ignore_errors=True)
    _, wait_status = os.waitpid(pid, 0)
    status = os.waitstatus_to_exitcode(wait_status)

sys.exit(status if status >= 0 else 128 - status)
