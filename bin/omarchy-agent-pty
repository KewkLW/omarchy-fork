#!/usr/bin/python3

# omarchy:summary=Run an agent under a pty relay so other agents and the user can speak to it
# omarchy:args=<kind> <command> [args...]
# omarchy:hidden=true

# omarchy-agent starts agents through this relay. It passes the terminal through
# untouched and opens input.sock in the agent's room directory. A message sent to
# the agent, by another agent or by the user from the room pane, is typed into
# its prompt, headed with who sent it and how to answer. The relay works out the
# sender itself, from the connecting process's tree, so nothing a message says
# can change who it appears to be from.

import errno
import fcntl
import json
import os
import pty
import select
import signal
import socket
import struct
import subprocess
import sys
import termios
import time
import tty

if len(sys.argv) < 3:
    print("Usage: omarchy-agent-pty <kind> <command> [args...]", file=sys.stderr)
    sys.exit(1)

kind, command = sys.argv[1], sys.argv[2:]

# Paste mode markers, watched for in the agent's output: a message typed into a
# prompt that understands bracketed paste arrives as one paste, so a multi-line
# message can't submit early at its first newline.
PASTE_ON, PASTE_OFF = b"\x1b[?2004h", b"\x1b[?2004l"
MAX_MESSAGE = 64 * 1024

# The agent waits for the relay to register it before it starts, so nothing it
# says in its first moments can be taken for whoever launched it.
go_read, go_write = os.pipe()
pid, master = pty.fork()
if pid == 0:
    os.close(go_write)
    os.read(go_read, 1)
    os.close(go_read)
    try:
        os.execvp(command[0], command)
    except OSError as error:
        print(f"{command[0]}: {error.strerror}", file=sys.stderr)
    os._exit(127)

stdin = sys.stdin.fileno()
stdout = sys.stdout.fileno()
interactive = os.isatty(stdin)


def copy_size(*_):
    if interactive:
        size = fcntl.ioctl(stdin, termios.TIOCGWINSZ, b"\0" * 8)
        fcntl.ioctl(master, termios.TIOCSWINSZ, size)
        os.kill(pid, signal.SIGWINCH)


copy_size()
signal.signal(signal.SIGWINCH, copy_size)
saved = termios.tcgetattr(stdin) if interactive else None
if interactive:
    tty.setraw(stdin)

listener = None
sock_path = None
try:
    meta = json.loads(subprocess.run(
        ["omarchy-agent-room-core", "register", kind, str(pid)],
        capture_output=True, text=True, check=True,
    ).stdout)
    sock_path = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "omarchy", "agents", meta["id"], "input.sock")
    try:
        os.unlink(sock_path)
    except FileNotFoundError:
        pass
    os.umask(0o077)
    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    listener.bind(sock_path)
    os.chmod(sock_path, 0o600)
    listener.listen(4)
except (OSError, subprocess.CalledProcessError, ValueError):
    # The agent still runs without the room; it just can't be spoken to.
    listener = None
    meta = {"id": None}

os.close(go_read)
os.write(go_write, b"x")
os.close(go_write)


def sender(conn):
    peer_pid, peer_uid, _ = struct.unpack("3i", conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
    if peer_uid != os.getuid():
        return None
    result = subprocess.run(["omarchy-agent-room-core", "whois", str(peer_pid)], capture_output=True, text=True)
    try:
        who = json.loads(result.stdout)
    except ValueError:
        return None
    # An agent talking to itself through its own relay is a loop, not a message.
    return None if who["id"] == meta["id"] else who


def heading(who):
    if who["id"] == "user":
        name = "The user"
    elif who.get("name"):
        name = f"{who['name']} ({who['id']})"
    else:
        name = who["id"]
    return f"[Agent room] {name} says:", f'(Answer in the room: omarchy agent send {who["id"]} "...")'


def type_message(who, text, paste):
    text = text.strip()
    if not text:
        return
    head, answer = heading(who)
    if paste:
        os.write(master, b"\x1b[200~" + f"{head}\n{text}\n{answer}".encode() + b"\x1b[201~")
    else:
        os.write(master, " ".join(f"{head} {text} {answer}".split("\n")).encode())
    # Prompts that read the paste and the Enter in one go take the Enter as part
    # of the paste, so give the paste a moment to land first.
    time.sleep(0.1)
    os.write(master, b"\r")


def accept(paste):
    conn, _ = listener.accept()
    with conn:
        conn.settimeout(2)
        who = sender(conn)
        if who is None:
            return
        data = b""
        try:
            while len(data) < MAX_MESSAGE:
                chunk = conn.recv(4096)
                if not chunk:
                    break
                data += chunk
            type_message(who, data[:MAX_MESSAGE].decode(errors="replace"), paste)
            conn.sendall(b"ok")
        except OSError:
            return


paste = False
tail = b""
status = 0
try:
    while True:
        watched = [master] + ([stdin] if interactive else []) + ([listener] if listener else [])
        try:
            ready, _, _ = select.select(watched, [], [])
        except InterruptedError:
            continue
        if master in ready:
            try:
                data = os.read(master, 65536)
            except OSError as error:
                if error.errno != errno.EIO:
                    raise
                data = b""
            if not data:
                break
            os.write(stdout, data)
            seen = tail + data
            on, off = seen.rfind(PASTE_ON), seen.rfind(PASTE_OFF)
            if on != off:
                paste = on > off
            tail = seen[-(len(PASTE_ON) - 1):]
        if interactive and stdin in ready:
            data = os.read(stdin, 65536)
            if not data:
                break
            os.write(master, data)
        if listener and listener in ready:
            accept(paste)
finally:
    if saved is not None:
        termios.tcsetattr(stdin, termios.TCSAFLUSH, saved)
    if sock_path:
        try:
            os.unlink(sock_path)
        except OSError:
            pass
    _, wait_status = os.waitpid(pid, 0)
    status = os.waitstatus_to_exitcode(wait_status)

sys.exit(status if status >= 0 else 128 - status)
