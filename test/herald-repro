#!/bin/bash

# TEMP herald (scratch branch only, never upstream): #17823's body steps run
# verbatim (test/herald-17823-step*.sh are extracted from the drafted body),
# with the PR head's own battlenet.lua. Always exits 0.

set +e +u
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
OUT="$HOME/shell-logs/herald"
mkdir -p "$OUT"
log() { printf 'herald: %s\n' "$*" | tee -a "$OUT/log.txt"; }
log "$(hyprctl version 2>&1 | head -n 1); DISPLAY '${DISPLAY:-}'"
installed=/usr/share/omarchy
log "installed battlenet.lua vs quattro's: $(cmp "$installed/default/hypr/apps/battlenet.lua" "$ROOT/default/hypr/apps/battlenet.lua" 2>&1 && echo same)"
cp "$HOME/.config/hypr/hyprland.lua" "$OUT/hyprland.lua.orig"
cp "$ROOT/test/herald-x11-standin.py" "$HOME/standin.py"
checkout="$HOME/pr17823"
mkdir -p "$checkout/default/hypr/apps"
cp "$ROOT/test/herald-pr17823-head-battlenet.lua" "$checkout/default/hypr/apps/battlenet.lua"
events="$OUT/socket2.txt"
socat -u "UNIX-CONNECT:$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock" - >"$events" 2>&1 &

step1() {
  local label=$1 mark
  log "#17823 $label clients before: $(hyprctl clients -j | jq -c '[.[] | select(.class == "steam_app_battlenet") | .title]')"
  mark=$(wc -l <"$events")
  log "#17823 $label step 1 output: $(cd "$HOME" && timeout 60 bash "$ROOT/test/herald-17823-step1.sh" 2>&1 | tr '\n' '|')"
  log "#17823 $label events: $(tail -n +$((mark + 1)) "$events" | grep -E "^(activewindow|urgent)>>" | tr '\n' ' ' | head -c 600)"
  sleep 2
}

step1 base
log "#17823 step 2 output: '$(cd "$checkout" && bash "$ROOT/test/herald-17823-step2.sh" 2>&1 | tr '\n' '|')'"
log "#17823 module file: $(hyprctl repl 'return package.searchpath("default.hypr.apps.battlenet", package.path)' 2>&1 | head -c 200)"
step1 head
cp "$OUT/hyprland.lua.orig" "$HOME/.config/hypr/hyprland.lua"
hyprctl reload >/dev/null 2>&1
log "done"
exit 0
