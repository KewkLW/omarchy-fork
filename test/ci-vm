#!/bin/bash

# Runs ./test/all on a real Omarchy install: a throwaway copy of an installed
# VM image, booted for this run, the checkouts copied in, the tests run in the
# desktop session as the logged-in user. Nothing is left behind.
#
#   test/ci-vm <image_dir> <sources_dir> <out_dir> [test/all args...]
#
#   image_dir    base.qcow2 with vmlinuz, initrd and cmdline beside it: a VM
#                image omarchy-iso publishes, and its unpacked/ files
#   sources_dir  holds omarchy/ (what is tested) and omarchy-pkgs/
#   out_dir      gets run.log (every test file's output, whole) and the boot analysis
#
# Env: SMP (default 4), MEM (default 8G), VM_STATE_DIR (where the run's disk
# and sockets go, default /var/tmp), OMARCHY_TEST_COMP_JOBS (parallel
# compositor test workers inside the VM).

set -euo pipefail

# print_failure_logs, which test/shell.d/test-runner-test.sh checks too.
source "$(dirname -- "${BASH_SOURCE[0]}")/ci-failure-logs"

image=$1 sources=$2 out=$3
shift 3
suite_args=("$@")
state=$(mktemp -d "${VM_STATE_DIR:-/var/tmp}/ci-vm.XXXXXX") # the socket's path has to stay under 108 bytes
port=$(( 20000 + RANDOM % 10000 ))
mkdir -p "$out"

ssh_vm() {
  ssh -i "$state/id_ed25519" -p "$port" -o BatchMode=yes -o IdentitiesOnly=yes \
    -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o ConnectTimeout="${CONNECT_TIMEOUT:-5}" -o LogLevel=ERROR \
    -o ControlMaster=auto -o ControlPath="$state/ssh.sock" -o ControlPersist=600 omarchy@127.0.0.1 "$@"
}
seconds() { echo $(( SECONDS - started )); }
# Every test file's log. test/shell prints them into run.log only once all
# files have finished, so after a hang these are the only output there is.
pull_shell_logs() {
  ssh_vm 'mkdir -p ~/shell-logs && find /tmp -maxdepth 1 -name "omarchy-test-shell.*" -newer ~/started -exec cp -r {} ~/shell-logs/ \; && tar cf - -C ~ shell-logs' |
    tar xf - --no-same-owner -C "$out" || true
}
# test/shell prints each file's output only once every file has finished, so
# meanwhile report from its log directory, where each file leaves a .code file
# the moment it ends: how many are done, and which have failed so far.
shell_progress() {
  ssh_vm 'total=$(sed -n "/^==> test\/shell\$/,\$ s/^Running \([0-9][0-9]*\) test files$/\1/p" ~/run.log | head -n 1)
    [[ -n $total ]] || total=$(( $(ls ~/src/omarchy/test/shell.d/*-test.sh | wc -l) - 1 ))
    dir=$(sed -n "/^==> test\/shell\$/,\$ s/^Logging every file to //p" ~/run.log | head -n 1)
    if [[ -n $dir ]]; then
      finished=$(find "$dir" -maxdepth 1 -name "*.code" | wc -l)
      failed=$(grep -Lx 0 "$dir"/*.code 2>/dev/null | xargs -r -n 1 basename | sed "s/\.code$//" | tr "\n" " " | sed "s/ $//")
      echo "$finished of $total test files done${failed:+; failed so far: $failed}"
    fi'
}
# The kernel's and systemd-oomd's logs, kept beside the tests' and searched for
# OOM kills, which a test sees only as a child that died of SIGKILL.
pull_kernel_log() {
  ssh_vm 'journalctl -k -b --no-pager; journalctl -b -u systemd-oomd --no-pager' >"$out/kernel.txt" 2>&1 || true
  echo "test/ci-vm: kernel log, $(wc -l <"$out/kernel.txt") lines"
  grep -E 'invoked oom-killer|Out of memory: Killed process|systemd-oomd.*Killed' "$out/kernel.txt" | sed 's/^/test\/ci-vm: /' || true
}
# On failure or timeout, also keep the user session journal and coredump list
# so kills or crashes that leave no kernel/oomd line can still be diagnosed.
pull_user_journal() {
  ssh_vm 'journalctl --user -b --no-pager; echo "=== coredumpctl ==="; coredumpctl list --no-pager 2>&1 || true' >"$out/user-journal.txt" 2>&1 || true
}
cleanup() {
  ssh -o ControlPath="$state/ssh.sock" -O exit omarchy@127.0.0.1 2>/dev/null || true
  if [[ -f $state/qemu.pid ]]; then
    kill "$(cat "$state/qemu.pid")" 2>/dev/null || true
  fi
  rm -rf "$state"
}
trap cleanup EXIT

# A key made for this run only, handed in through the firmware tables as a
# systemd credential: the image holds no key, and no run can reuse another's.
ssh-keygen -q -t ed25519 -N '' -C ci-vm -f "$state/id_ed25519"
# TEMP tryit (scratch, never upstream): sudo without a password for the VM's
# user, from the same root tmpfiles credential as the key: pkg add, dev link,
# dev unlink and the reboots need sudo, where a tester types their password.
keys=$(printf 'd /home/omarchy/.ssh 0700 omarchy omarchy -\nf+ /home/omarchy/.ssh/authorized_keys 0600 omarchy omarchy - %s\nf+ /etc/sudoers.d/zz-ci-tryit 0440 root root - omarchy ALL=(ALL) NOPASSWD: ALL\n' \
  "$(cat "$state/id_ed25519.pub")" | base64 -w0)

qemu-img create -qf qcow2 -b "$(realpath "$image/base.qcow2")" -F qcow2 "$state/run.qcow2"
started=$SECONDS
# Straight into the kernel: no firmware, no boot loader. The image takes its
# machine ID from -uuid, so every run is a machine of its own. The console
# argument keeps systemd from waiting on a terminal that never answers.
qemu-system-x86_64 -cpu host -enable-kvm -machine q35,accel=kvm -smp "${SMP:-4}" -m "${MEM:-8G}" \
  -kernel "$image/vmlinuz" -initrd "$image/initrd" \
  -append "$(cat "$image/cmdline") systemd.tty.term.console=dumb" \
  -uuid "$(cat /proc/sys/kernel/random/uuid)" \
  -drive "file=$state/run.qcow2,format=qcow2,if=none,id=d0,cache=unsafe,discard=unmap" -device virtio-blk-pci,drive=d0 \
  -smbios "type=11,value=io.systemd.credential.binary:tmpfiles.extra=$keys" \
  -device virtio-vga -device virtio-rng-pci -display none \
  -netdev "user,id=n0,hostfwd=tcp:127.0.0.1:$port-:22" -device virtio-net-pci,netdev=n0 \
  -pidfile "$state/qemu.pid" -daemonize

until CONNECT_TIMEOUT=1 ssh_vm true 2>/dev/null; do
  if (( $(seconds) >= 300 )); then
    echo "test/ci-vm: no SSH after 300 s" >&2
    exit 1
  else
    sleep 0.3
  fi
done
echo "test/ci-vm: SSH after $(seconds) s"

(cd "$sources" && tar cf - --exclude=.git/objects/pack/tmp_* omarchy omarchy-pkgs) |
  ssh_vm 'mkdir -p ~/src && tar xf - -C ~/src'

# The tests keep the environment they start with, so wait for the session to
# publish its compositor.
until ssh_vm 'systemctl --user show-environment | grep -q ^HYPRLAND_INSTANCE_SIGNATURE='; do
  if (( $(seconds) >= 300 )); then
    echo "test/ci-vm: no desktop session after 300 s" >&2
    exit 1
  else
    sleep 0.3
  fi
done
echo "test/ci-vm: sources copied and desktop up after $(seconds) s"

# Nobody touches this machine, and after a few minutes without input Omarchy
# turns the screen off. The tests that read the screen then read black.
if ! ssh_vm 'systemd-run --user --quiet --collect --wait omarchy-toggle-idle stay-awake' >/dev/null; then
  echo "test/ci-vm: could not keep the session awake" >&2
  exit 1
fi

# TEMP tryit (scratch, never upstream): the "Try it" section of PR #15087 on
# this VM, in place of ./test/all (the suite arguments are ignored).
# test/tryit/steps runs the section's lines verbatim in the desktop session,
# phase by phase; this file does the reboots between them, as a tester does.
: "${suite_args[@]+}"
tryit_say() { echo "test/ci-vm: TEMP tryit: $*"; }
pull_shots() {
  ssh_vm 'mkdir -p ~/tryit-shots && tar cf - -C ~ tryit-shots' | tar xf - --no-same-owner -C "$out" 2>/dev/null || true
}
tryit_fail() {
  echo "test/ci-vm: TEMP tryit: FAIL: $*" >&2
  pull_shots
  pull_user_journal
  pull_kernel_log
  exit 1
}
# A connection of its own, bounded and never shared, for a machine that is
# going down or coming up.
tryit_ssh() {
  timeout "$1" ssh -i "$state/id_ed25519" -p "$port" -o BatchMode=yes -o IdentitiesOnly=yes \
    -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=2 -o LogLevel=ERROR \
    -o ControlMaster=no -o ControlPath=none omarchy@127.0.0.1 "${@:2}"
}
# A guest reboot comes back through the same kernel and the overlay keeps the
# disk, so the VM reboots as a laptop does; wait for its session as at boot.
tryit_reboot() {
  local before after deadline
  before=$(ssh_vm 'cat /proc/sys/kernel/random/boot_id')
  tryit_ssh 30 'sudo -n systemctl reboot' >/dev/null 2>&1 || true
  ssh -o ControlPath="$state/ssh.sock" -O exit omarchy@127.0.0.1 2>/dev/null || true
  rm -f "$state/ssh.sock"
  deadline=$(( SECONDS + 300 ))
  until after=$(tryit_ssh 20 'cat /proc/sys/kernel/random/boot_id' 2>/dev/null) && [[ -n $after && $after != "$before" ]]; do
    (( SECONDS < deadline )) || tryit_fail "the VM did not come back from a reboot within 300 s"
    sleep 1
  done
  until ssh_vm 'systemctl --user show-environment | grep -q ^HYPRLAND_INSTANCE_SIGNATURE='; do
    (( SECONDS < deadline )) || tryit_fail "no desktop session within 300 s of a reboot"
    sleep 0.5
  done
  # The shell and the first-login notifications settle before the next phase.
  sleep 10
  ssh_vm 'systemd-run --user --quiet --collect --wait omarchy-toggle-idle stay-awake' >/dev/null || tryit_say "could not keep the session awake after a reboot"
  tryit_say "rebooted (boot $after), desktop up after $(seconds) s"
}
# One phase of test/tryit/steps in the desktop session's user manager: the
# environment a terminal opened in the session gets.
tryit_phase() {
  local rc=0
  tryit_say "phase $1 starts after $(seconds) s"
  ssh_vm "timeout 900 systemd-run --user --quiet --collect --wait --pipe bash ~/src/omarchy/test/tryit/steps $1" </dev/null 2>&1 | tee "$out/tryit-$1.log" || rc=$?
  tryit_say "phase $1 ended with $rc after $(seconds) s; $(grep -c ' ok - ' "$out/tryit-$1.log") ok, $(grep -c ' FAIL - ' "$out/tryit-$1.log") FAIL"
  pull_shots
  return "$rc"
}

ssh_vm 'sudo -n true' || tryit_fail "sudo without a password: $(ssh_vm 'sudo -n -l 2>&1; ls -l /etc/sudoers.d 2>&1' || true)"
tryit_say "image: $(ssh_vm 'pacman -Q omarchy hyprland chromium google-chrome bubblewrap wayland-protocols wtype 2>&1 | tr "\n" " "')"
tryit_say "tested tree: $(ssh_vm 'cd ~/src/omarchy && git log --format="%H %s" -3 | tr "\n" ";"')"
date +%s >/dev/null
ssh_vm 'date +%s.%N >~/started'

# A tester's machine has its sync databases; the image has none. And the image
# already ships both packages, so they go first, for pkg add to install them.
tryit_say "harness: $(ssh_vm 'sudo -n pacman -Sy --noconfirm >/dev/null 2>&1 && echo synced the pacman databases; sudo -n pacman -Rdd --noconfirm bubblewrap wayland-protocols 2>&1 | tail -n 1; pacman -Q bubblewrap wayland-protocols 2>&1 | tr "\n" " "')"

results=()
tryit_phase quick && results+=("quick=ok") || results+=("quick=FAIL")
[[ $(ssh_vm 'cat /etc/omarchy.conf') == *omarchy-agent-seat* ]] || tryit_fail "the quick phase did not link the clone; the rest needs it"
tryit_reboot

# The harness's own keyboard for pressing the binding and picking menu rows:
# not a tester's step.
ssh_vm 'sudo -n pacman -S --noconfirm --needed wtype ydotool >/dev/null 2>&1 || sudo -n pacman -Sy --noconfirm --needed wtype ydotool >/dev/null 2>&1; pacman -Q wtype ydotool | tr "\n" " "' | sed 's/^/test\/ci-vm: TEMP tryit: harness: /' || true
tryit_phase linked && results+=("linked=ok") || results+=("linked=FAIL")
[[ $(ssh_vm 'cat /etc/omarchy.conf') == *'"/usr/share/omarchy"'* ]] || tryit_fail "the linked phase did not unlink; the rest needs it"
tryit_reboot

tryit_phase after && results+=("after=ok") || results+=("after=FAIL")

pull_user_journal
pull_kernel_log
tryit_say "every check, in order:"
grep -h -E '^TRYIT [a-z]+ (ok|FAIL) - ' "$out"/tryit-quick.log "$out"/tryit-linked.log "$out"/tryit-after.log 2>/dev/null | sed 's/^/  /'
tryit_say "results: ${results[*]}"
[[ ${results[*]} == "quick=ok linked=ok after=ok" ]]
